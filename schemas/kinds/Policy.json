{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "EntitySelector": {
      "additionalProperties": false,
      "description": "Entity type and id/pattern selector within a policy grant (R6).",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/definitions/Urn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit target entity URN."
        },
        "idPattern": {
          "description": "Anchored regular expression matching target entity URNs (R24, R33).",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "Target entity type short name in PascalCase.",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Operation": {
      "description": "Table 4.20-1: every named distributed API operation in ETSI GS CIM 009 (R8).\n\nClosed enum ensures no proprietary verbs (`upsertEntity`, `read`, `write`) are accepted, satisfying the strict R8 CIM 009 vocabulary guarantee.",
      "oneOf": [
        {
          "description": "Create entity (`POST /entities`).",
          "enum": [
            "createEntity"
          ],
          "type": "string"
        },
        {
          "description": "Update entity (`PATCH /entities/{id}`).",
          "enum": [
            "updateEntity"
          ],
          "type": "string"
        },
        {
          "description": "Append entity attributes (`POST /entities/{id}/attrs`).",
          "enum": [
            "appendAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Update entity attributes (`PATCH /entities/{id}/attrs`).",
          "enum": [
            "updateAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Delete entity attributes (`DELETE /entities/{id}/attrs/{attr}`).",
          "enum": [
            "deleteAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Delete entity (`DELETE /entities/{id}`).",
          "enum": [
            "deleteEntity"
          ],
          "type": "string"
        },
        {
          "description": "Batch create entities (`POST /entityOperations/create`).",
          "enum": [
            "createBatch"
          ],
          "type": "string"
        },
        {
          "description": "Batch upsert entities (`POST /entityOperations/upsert`).",
          "enum": [
            "upsertBatch"
          ],
          "type": "string"
        },
        {
          "description": "Batch update entities (`POST /entityOperations/update`).",
          "enum": [
            "updateBatch"
          ],
          "type": "string"
        },
        {
          "description": "Batch delete entities (`POST /entityOperations/delete`).",
          "enum": [
            "deleteBatch"
          ],
          "type": "string"
        },
        {
          "description": "Upsert temporal entity attributes (`POST /temporal/entities/{id}/attrs`).",
          "enum": [
            "upsertTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Append temporal entity attributes (`POST /temporal/entities/{id}/attrs`).",
          "enum": [
            "appendAttrsTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Delete temporal entity attributes (`DELETE /temporal/entities/{id}/attrs/{attr}`).",
          "enum": [
            "deleteAttrsTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Update temporal attribute instance (`PATCH /temporal/entities/{id}/attrs/{attr}/{instance}`).",
          "enum": [
            "updateAttrInstanceTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Delete temporal attribute instance (`DELETE /temporal/entities/{id}/attrs/{attr}/{instance}`).",
          "enum": [
            "deleteAttrInstanceTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Delete temporal entity (`DELETE /temporal/entities/{id}`).",
          "enum": [
            "deleteTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Merge entity (`PATCH /entities/{id}`).",
          "enum": [
            "mergeEntity"
          ],
          "type": "string"
        },
        {
          "description": "Replace entity (`PUT /entities/{id}`).",
          "enum": [
            "replaceEntity"
          ],
          "type": "string"
        },
        {
          "description": "Replace entity attributes (`PATCH /entities/{id}/attrs`).",
          "enum": [
            "replaceAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Batch merge entities (`POST /entityOperations/merge`).",
          "enum": [
            "mergeBatch"
          ],
          "type": "string"
        },
        {
          "description": "Purge entity permanently (`DELETE /entities/{id}?purge=true`).",
          "enum": [
            "purgeEntity"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve single entity (`GET /entities/{id}`).",
          "enum": [
            "retrieveEntity"
          ],
          "type": "string"
        },
        {
          "description": "Query entities (`GET /entities` or `POST /entityOperations/query`).",
          "enum": [
            "queryEntity"
          ],
          "type": "string"
        },
        {
          "description": "Batch query entities (`POST /entityOperations/query`).",
          "enum": [
            "queryBatch"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve temporal entity (`GET /temporal/entities/{id}`).",
          "enum": [
            "retrieveTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Query temporal entities (`GET /temporal/entities`).",
          "enum": [
            "queryTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve entity types list (`GET /types`).",
          "enum": [
            "retrieveEntityTypes"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve entity type details (`GET /types/{type}`).",
          "enum": [
            "retrieveEntityTypeDetails"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve entity type info (`GET /types/{type}/info`).",
          "enum": [
            "retrieveEntityTypeInfo"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve attribute types list (`GET /attributes`).",
          "enum": [
            "retrieveAttrTypes"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve attribute type details (`GET /attributes/{attr}`).",
          "enum": [
            "retrieveAttrTypeDetails"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve attribute type info (`GET /attributes/{attr}/info`).",
          "enum": [
            "retrieveAttrTypeInfo"
          ],
          "type": "string"
        },
        {
          "description": "Create context subscription (`POST /subscriptions`).",
          "enum": [
            "createSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Update context subscription (`PATCH /subscriptions/{id}`).",
          "enum": [
            "updateSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve context subscription (`GET /subscriptions/{id}`).",
          "enum": [
            "retrieveSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Query context subscriptions (`GET /subscriptions`).",
          "enum": [
            "querySubscription"
          ],
          "type": "string"
        },
        {
          "description": "Delete context subscription (`DELETE /subscriptions/{id}`).",
          "enum": [
            "deleteSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve context entity map (`GET /entityMaps/{id}`).",
          "enum": [
            "retrieveEntityMap"
          ],
          "type": "string"
        },
        {
          "description": "Update context entity map (`PATCH /entityMaps/{id}`).",
          "enum": [
            "updateEntityMap"
          ],
          "type": "string"
        },
        {
          "description": "Delete context entity map (`DELETE /entityMaps/{id}`).",
          "enum": [
            "deleteEntityMap"
          ],
          "type": "string"
        },
        {
          "description": "Create entity map query on entities.",
          "enum": [
            "createEntityMapQueryEntity"
          ],
          "type": "string"
        },
        {
          "description": "Create entity map query on temporal entities.",
          "enum": [
            "createEntityMapQueryTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve context source identity (`GET /csourceIdentity`).",
          "enum": [
            "retrieveContextSourceIdentity"
          ],
          "type": "string"
        }
      ]
    },
    "OperationGroup": {
      "description": "Table 4.20-2: the five distributed operation group names (R8).",
      "oneOf": [
        {
          "description": "Consumption, subscription, and entity map operations.",
          "enum": [
            "federationOps"
          ],
          "type": "string"
        },
        {
          "description": "Association operations without entity map support.",
          "enum": [
            "associationOps"
          ],
          "type": "string"
        },
        {
          "description": "Entity and attribute update operations.",
          "enum": [
            "updateOps"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve and query entity operations.",
          "enum": [
            "retrieveOps"
          ],
          "type": "string"
        },
        {
          "description": "Full redirection operations.",
          "enum": [
            "redirectionOps"
          ],
          "type": "string"
        }
      ]
    },
    "OperationRef": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/definitions/Operation"
            }
          ],
          "description": "Individual named operation from CIM 009 Table 4.20-1."
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/OperationGroup"
            }
          ],
          "description": "Operation group from CIM 009 Table 4.20-2."
        }
      ],
      "description": "Reference to a CIM 009 operation or operation group (R8).\n\nClosed enum ensures no proprietary verbs (`read`, `write`, `upsertEntity`) are permitted, satisfying the strict R8 CIM 009 vocabulary guarantee."
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        },
        {
          "description": "The platform holds something the repository does not declare, or no longer holds what it does (CC-21, UI-25). Configuration cannot reach this phase — every component reads it from the repository (CC-72) — so it is a space whose seed entities the broker answers differently, and the two resolutions of UI-26 are what a person does about it.",
          "enum": [
            "Drifted"
          ],
          "type": "string"
        }
      ]
    },
    "PolicyEffect": {
      "description": "Whether a policy grants access or takes it away (GW4, GW8).\n\nA prohibition subtracts from a grant that stays in force. It is not how a resource is kept private in the first place: the default verdict is already DENY (GW5), so a type nobody was granted is closed without any policy naming it.",
      "oneOf": [
        {
          "description": "The policy grants the operations it lists (the default).",
          "enum": [
            "permission"
          ],
          "type": "string"
        },
        {
          "description": "The policy denies them, and is evaluated before any permission (GW4).",
          "enum": [
            "prohibition"
          ],
          "type": "string"
        }
      ]
    },
    "PolicySpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`Policy`][crate::kinds::Policy] resource (ADR 002, R1..R9).",
      "properties": {
        "assignee": {
          "allOf": [
            {
              "$ref": "#/definitions/Principal"
            }
          ],
          "description": "Grantee principal receiving permissions."
        },
        "assigner": {
          "description": "Granting data owner (e.g. `did:web:banskabystrica.sk`).",
          "type": "string"
        },
        "contextSpaceRef": {
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ],
          "description": "Reference to the target ContextSpace."
        },
        "effect": {
          "allOf": [
            {
              "$ref": "#/definitions/PolicyEffect"
            }
          ],
          "default": "permission",
          "description": "Whether this policy grants or takes away (GW4, GW8)."
        },
        "geoQ": {
          "description": "Residual geographic query filter string (R7, GW11, EP-56).",
          "type": [
            "string",
            "null"
          ]
        },
        "information": {
          "description": "Target entity types and attribute whitelist (R6, R9).",
          "items": {
            "$ref": "#/definitions/RegistrationInfo"
          },
          "type": "array"
        },
        "operations": {
          "description": "Granted CIM 009 operations or operation groups (R8).",
          "items": {
            "$ref": "#/definitions/OperationRef"
          },
          "type": "array"
        },
        "q": {
          "description": "Residual NGSI-LD query filter string (R7, EP-56).",
          "type": [
            "string",
            "null"
          ]
        },
        "scopeQ": {
          "description": "Residual scope query filter string (R7, R13, EP-56).",
          "type": [
            "string",
            "null"
          ]
        },
        "temporalQ": {
          "description": "Residual temporal query filter string (R7, GW11, EP-56).",
          "type": [
            "string",
            "null"
          ]
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/definitions/Validity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional time validity window for this policy."
        }
      },
      "required": [
        "assignee",
        "assigner",
        "contextSpaceRef",
        "operations"
      ],
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Identity principal receiving a policy grant (ADR 002).",
      "properties": {
        "id": {
          "description": "Identifier of the principal (username, role name, group name, DID).",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/PrincipalKind"
            }
          ],
          "description": "Category of principal."
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "PrincipalKind": {
      "description": "Principal category for authorization rules.",
      "oneOf": [
        {
          "description": "Individual human user identity.",
          "enum": [
            "user"
          ],
          "type": "string"
        },
        {
          "description": "Group of users.",
          "enum": [
            "group"
          ],
          "type": "string"
        },
        {
          "description": "Platform role.",
          "enum": [
            "role"
          ],
          "type": "string"
        },
        {
          "description": "Non-human service account.",
          "enum": [
            "serviceAccount"
          ],
          "type": "string"
        },
        {
          "description": "Decentralized identifier (`did:web:...`).",
          "enum": [
            "did"
          ],
          "type": "string"
        }
      ]
    },
    "Ref": {
      "anyOf": [
        {
          "description": "Bare string resource name.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TypedRef"
            }
          ],
          "description": "Typed reference with kind, name, and optional namespace."
        }
      ],
      "description": "Reference to another resource, either bare name or typed reference (MF-07)."
    },
    "RegistrationInfo": {
      "additionalProperties": false,
      "description": "Specification of target entity types, properties, and relationships (R6).",
      "properties": {
        "entities": {
          "description": "Target entity selectors.",
          "items": {
            "$ref": "#/definitions/EntitySelector"
          },
          "type": "array"
        },
        "propertyNames": {
          "description": "Whitelist of readable or writable property names (R6, R9).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "relationshipNames": {
          "description": "Whitelist of readable or writable relationship names (R6, R9).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "entities"
      ],
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/definitions/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the build lane published for an `App`, and the only place its artifact is named (AP-13a). Written back by the build lane in the commit that publishes the artifact; an App without it renders no pod, and no other principal may set it (AP-73)."
        },
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "Text": {
      "anyOf": [
        {
          "description": "The form every new manifest writes.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            }
          ],
          "description": "The legacy `{locale: text}` map."
        }
      ],
      "description": "A human label or description (UI-50): one plain string in the author's language. The legacy language map is still read, through release `v0.9`, and resolves to one string."
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "Urn": {
      "description": "NGSI-LD entity URN conforming to ADR 001 / PF-42: urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}",
      "pattern": "^urn:ngsi-ld:[A-Z][A-Za-z0-9]{1,63}:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+:[a-z0-9][a-z0-9-]{0,62}:[A-Za-z0-9._~-]{1,128}$",
      "type": "string"
    },
    "Validity": {
      "additionalProperties": false,
      "description": "Temporal validity window for a policy grant.",
      "properties": {
        "from": {
          "description": "Effective start timestamp (UTC).",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "Effective expiration timestamp (UTC).",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version: [`API_VERSION`], or a version [`serves`] accepts for this kind.",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
