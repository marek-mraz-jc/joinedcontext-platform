{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AgentLimits": {
      "additionalProperties": false,
      "description": "`spec.limits.agents`: model spend in whole units of the currency the agent proxy's provider bills in, the day and the month in UTC.",
      "properties": {
        "spendPerDay": {
          "description": "Spend a day; absent is no limit.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "spendPerMonth": {
          "description": "Spend a month; absent is no limit.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AgentsPolicy": {
      "additionalProperties": false,
      "description": "`spec.policies.agents`.",
      "properties": {
        "models": {
          "description": "The models the agent proxy lets a run call. Absent is every model the installation's agent profiles name; a model outside those is never reachable whatever this lists.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AppsPolicy": {
      "additionalProperties": false,
      "description": "`spec.policies.apps` (PF-103).",
      "properties": {
        "public": {
          "allOf": [
            {
              "$ref": "#/definitions/PublicApps"
            }
          ],
          "description": "Whether an App may be `public`; `refused` makes every door refuse a Change that sets an App public, and leaves the Apps already public as they are (PF-100, PF-103)."
        }
      },
      "type": "object"
    },
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "description": "Contact information for an organization role.",
      "properties": {
        "email": {
          "description": "Contact email address.",
          "type": "string"
        },
        "name": {
          "description": "Full name of the contact person or organizational unit.",
          "type": "string"
        },
        "phone": {
          "description": "Optional contact telephone number.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "allOf": [
            {
              "$ref": "#/definitions/ContactRole"
            }
          ],
          "description": "Role of this contact."
        }
      },
      "required": [
        "email",
        "name",
        "role"
      ],
      "type": "object"
    },
    "ContactRole": {
      "description": "Functional responsibility of an organization contact.",
      "oneOf": [
        {
          "description": "Administrative contact.",
          "enum": [
            "administrative"
          ],
          "type": "string"
        },
        {
          "description": "Technical contact.",
          "enum": [
            "technical"
          ],
          "type": "string"
        },
        {
          "description": "Data protection officer / GDPR contact.",
          "enum": [
            "data-protection"
          ],
          "type": "string"
        },
        {
          "description": "Information security officer contact.",
          "enum": [
            "security"
          ],
          "type": "string"
        },
        {
          "description": "The open-data desk: the role address a dataset's catalogue record names as its contact point, which the Portal prefills into an Endpoint's `spec.catalog` (EP-78, EP-80).",
          "enum": [
            "open-data"
          ],
          "type": "string"
        }
      ]
    },
    "DataLimits": {
      "additionalProperties": false,
      "description": "`spec.limits.data`.",
      "properties": {
        "uploadMegabytes": {
          "description": "The largest upload or import, in MiB; at most the edge's body.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EdgeLimits": {
      "additionalProperties": false,
      "description": "`spec.limits.edge`.",
      "properties": {
        "maxRequestBodyMegabytes": {
          "description": "The largest request body the edge accepts, in MiB.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requestsPerMinute": {
          "allOf": [
            {
              "$ref": "#/definitions/EdgeRates"
            }
          ],
          "description": "Requests a minute per route class."
        }
      },
      "type": "object"
    },
    "EdgeRates": {
      "additionalProperties": false,
      "description": "`spec.limits.edge.requestsPerMinute`.",
      "properties": {
        "api": {
          "description": "The Portal API, per token.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "dataRead": {
          "description": "Context-space reads (`GET`, `HEAD`), per token.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "dataWrite": {
          "description": "Context-space writes (every other method), per token.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "publicEndpoint": {
          "description": "A public endpoint, per address.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "web": {
          "description": "The Portal's pages, per address.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "GatewayLimits": {
      "additionalProperties": false,
      "description": "`spec.limits.gateway`.",
      "properties": {
        "maxRequestBodyMegabytes": {
          "description": "The largest request body the gateway accepts, in MiB; at most the edge's.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "OrganizationLimits": {
      "additionalProperties": false,
      "description": "`spec.limits`: the organization's numbers (ADR-N-035 §3). Every field is optional; an absent one is its [`CATALOG`] default.",
      "properties": {
        "agents": {
          "allOf": [
            {
              "$ref": "#/definitions/AgentLimits"
            }
          ],
          "description": "Model spend of the assistant and agent runs."
        },
        "data": {
          "allOf": [
            {
              "$ref": "#/definitions/DataLimits"
            }
          ],
          "description": "Uploads and imports."
        },
        "edge": {
          "allOf": [
            {
              "$ref": "#/definitions/EdgeLimits"
            }
          ],
          "description": "What the edge admits."
        },
        "gateway": {
          "allOf": [
            {
              "$ref": "#/definitions/GatewayLimits"
            }
          ],
          "description": "What the context gateway admits."
        },
        "people": {
          "allOf": [
            {
              "$ref": "#/definitions/PeopleLimits"
            }
          ],
          "description": "Invitations."
        },
        "pipelines": {
          "allOf": [
            {
              "$ref": "#/definitions/PipelineLimits"
            }
          ],
          "description": "Pipeline outcomes and tests."
        },
        "signIn": {
          "allOf": [
            {
              "$ref": "#/definitions/SignInLimits"
            }
          ],
          "description": "How long a sign-in lasts."
        }
      },
      "type": "object"
    },
    "OrganizationPolicies": {
      "additionalProperties": false,
      "description": "`spec.policies`: the organization's choices (ADR-N-035 §3).",
      "properties": {
        "agents": {
          "allOf": [
            {
              "$ref": "#/definitions/AgentsPolicy"
            }
          ],
          "description": "What the assistant and agent runs may use."
        },
        "apps": {
          "allOf": [
            {
              "$ref": "#/definitions/AppsPolicy"
            }
          ],
          "description": "What the organization's Apps may be."
        },
        "signIn": {
          "allOf": [
            {
              "$ref": "#/definitions/SignInPolicy"
            }
          ],
          "description": "How people sign in."
        }
      },
      "type": "object"
    },
    "OrganizationSpec": {
      "additionalProperties": false,
      "description": "Desired specification of an [`Organization`][crate::kinds::Organization] resource (PF-01, PF-02, PF-25, PF-41).",
      "properties": {
        "contacts": {
          "description": "Administrative, technical, data protection, or security contacts.",
          "items": {
            "$ref": "#/definitions/Contact"
          },
          "type": "array"
        },
        "defaultLocale": {
          "description": "Organization fallback default locale, MUST be one of [`Self::locales`] (PF-25, PF-26).",
          "type": "string"
        },
        "domain": {
          "description": "Verified internet FQDN, the `{orgDomain}` of every entity URN (PF-41).",
          "type": "string"
        },
        "gitRepositoryUrl": {
          "description": "Git repository URL of the one Org Repository in Gitea (PF-02).",
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "allOf": [
            {
              "$ref": "#/definitions/OrganizationLimits"
            }
          ],
          "description": "The organization's numbers: edge rates, body sizes, sessions, invitations, model spend, pipeline outcomes and uploads (ADR-N-035, PF-96)."
        },
        "locales": {
          "description": "Ordered list of supported locales, most preferred first (PF-25).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policies": {
          "allOf": [
            {
              "$ref": "#/definitions/OrganizationPolicies"
            }
          ],
          "description": "The organization's choices: public apps, the password policy, the models agents may use (ADR-N-035, PF-96)."
        },
        "projects": {
          "allOf": [
            {
              "$ref": "#/definitions/ProjectsPolicy"
            }
          ],
          "default": {
            "creation": "org-admin",
            "visibility": "organization"
          },
          "description": "How projects are opened and who sees them (PF-61, PF-65)."
        }
      },
      "required": [
        "defaultLocale",
        "domain",
        "locales"
      ],
      "type": "object"
    },
    "PasswordPolicy": {
      "additionalProperties": false,
      "description": "`spec.policies.signIn.password`: written to the realm's password policy.",
      "properties": {
        "history": {
          "description": "How many earlier passwords a new one may not repeat; 0 to 24.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minLength": {
          "description": "The shortest password the realm accepts; at least 12.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PeopleLimits": {
      "additionalProperties": false,
      "description": "`spec.limits.people`.",
      "properties": {
        "invitationHours": {
          "description": "Hours an invitation link stays usable.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        },
        {
          "description": "The platform holds something the repository does not declare, or no longer holds what it does (CC-21, UI-25). Configuration cannot reach this phase — every component reads it from the repository (CC-72) — so it is a space whose seed entities the broker answers differently, and the two resolutions of UI-26 are what a person does about it.",
          "enum": [
            "Drifted"
          ],
          "type": "string"
        }
      ]
    },
    "PipelineLimits": {
      "additionalProperties": false,
      "description": "`spec.limits.pipelines`.",
      "properties": {
        "rejectedKept": {
          "description": "Rejected records a pipeline keeps, newest first.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sampleMegabytes": {
          "description": "The largest sample a pipeline test takes, in MiB; at most the edge's body.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProjectCreation": {
      "description": "Who may open a project (PF-65). `group:<name>` names a `Group` of the organization.",
      "oneOf": [
        {
          "description": "Every signed-in person of the organization.",
          "enum": [
            "Anyone"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The members of one group.",
          "properties": {
            "Group": {
              "type": "string"
            }
          },
          "required": [
            "Group"
          ],
          "type": "object"
        },
        {
          "description": "Whoever holds `propose` on `Project`, the seeded `org-admin`.",
          "enum": [
            "OrgAdmin"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectVisibility": {
      "description": "Who holds the seeded `viewer` role at organization scope (PF-61).",
      "oneOf": [
        {
          "description": "Every signed-in person of the organization reads every project.",
          "enum": [
            "organization"
          ],
          "type": "string"
        },
        {
          "description": "Only a principal a binding names reads a project.",
          "enum": [
            "members"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectsPolicy": {
      "additionalProperties": false,
      "description": "The organization's rules for its projects (PF-61, PF-65).",
      "properties": {
        "creation": {
          "allOf": [
            {
              "$ref": "#/definitions/ProjectCreation"
            }
          ],
          "default": "org-admin",
          "description": "Who may open a project: `anyone`, `group:<name>` or `org-admin` (PF-65)."
        },
        "nameCooldownDays": {
          "description": "How long a deleted project's name stays reserved, in days (PF-78). Absent is [`DEFAULT_NAME_COOLDOWN_DAYS`]; `0` frees the name the moment the project is gone.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "quota": {
          "anyOf": [
            {
              "$ref": "#/definitions/Quotas"
            },
            {
              "type": "null"
            }
          ],
          "description": "The quota every project the organization opens starts from (PF-73). A project may lower a value in the yellow lane; raising one above this is the red lane and an `org-admin`."
        },
        "visibility": {
          "allOf": [
            {
              "$ref": "#/definitions/ProjectVisibility"
            }
          ],
          "default": "organization",
          "description": "Who holds the seeded `viewer` role at organization scope: every signed-in person of the organization (`organization`, the default) or only whoever a binding names (`members`) (PF-61)."
        }
      },
      "type": "object"
    },
    "PublicApps": {
      "description": "Whether the organization's Apps may be public (PF-103).",
      "oneOf": [
        {
          "description": "An App may be public.",
          "enum": [
            "allowed"
          ],
          "type": "string"
        },
        {
          "description": "No Change may set an App public.",
          "enum": [
            "refused"
          ],
          "type": "string"
        }
      ]
    },
    "Quotas": {
      "additionalProperties": false,
      "description": "Structural resource quotas per project (PF-17).\n\nAn absent field indicates unlimited quota for that resource.",
      "properties": {
        "agentRunsPerDay": {
          "description": "Maximum number of agent runs the project starts in one day (PF-73, PF-74).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "apps": {
          "description": "Maximum number of Apps the project deploys (PF-73).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "contextSpaces": {
          "description": "Maximum number of active Context Spaces.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "entitiesPerSpace": {
          "description": "Maximum number of entities one Context Space of the project holds (PF-73).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ingestEventsPerSecond": {
          "description": "Maximum ingestion rate in events per second.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "publicEndpoints": {
          "description": "Maximum number of public endpoints.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requestsPerMinute": {
          "description": "Maximum requests per minute one Endpoint of the project serves (PF-73, EP-17).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "residentPipelines": {
          "description": "Maximum number of resident streaming pipelines.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SignInLimits": {
      "additionalProperties": false,
      "description": "`spec.limits.signIn`: written to the edge session and the realm alike (AP-29).",
      "properties": {
        "sessionIdleMinutes": {
          "description": "Minutes without a request before a session ends.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sessionMaxHours": {
          "description": "Hours after sign-in when a session ends whatever happens.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SignInPolicy": {
      "additionalProperties": false,
      "description": "`spec.policies.signIn`.",
      "properties": {
        "password": {
          "allOf": [
            {
              "$ref": "#/definitions/PasswordPolicy"
            }
          ],
          "description": "The realm's password policy."
        }
      },
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/definitions/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the build lane published for an `App`, and the only place its artifact is named (AP-13a). Written back by the build lane in the commit that publishes the artifact; an App without it renders no pod, and no other principal may set it (AP-73)."
        },
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "Text": {
      "anyOf": [
        {
          "description": "The form every new manifest writes.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
