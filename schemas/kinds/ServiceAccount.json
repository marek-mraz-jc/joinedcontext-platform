{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "Credential": {
      "additionalProperties": false,
      "description": "Declared credential for a service account (PF-36, PF-37).\n\n**Security note**: The security property of this kind is the complete absence of secret fields. `Credential` has nowhere to put a secret and carries `deny_unknown_fields`, so `secret:`, `value:`, `password:`, `clientSecret:` and `apiKey:` are all rejected at parse time (PF-36). The key id and the Argon2id hash are stored in the database / Keycloak / secret store, never in manifest state or Git.",
      "properties": {
        "expiresAt": {
          "description": "Optional expiration timestamp (UTC).",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "ipAllowList": {
          "description": "Whitelist of allowed client IP CIDR blocks (PF-36).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/CredentialKind"
            }
          ],
          "description": "Type of credential."
        },
        "name": {
          "description": "Credential identifier name (DNS-1123 label).",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "CredentialKind": {
      "description": "Category of service account credential.",
      "oneOf": [
        {
          "description": "Keycloak confidential OAuth 2.1 client with client_credentials flow.",
          "enum": [
            "oauth-client"
          ],
          "type": "string"
        },
        {
          "description": "Static hashed API bearer key for external legacy systems (PF-36, PF-37).",
          "enum": [
            "api-key"
          ],
          "type": "string"
        }
      ]
    },
    "KubernetesBinding": {
      "additionalProperties": false,
      "description": "Kubernetes ServiceAccount binding coordinates (PF-47).",
      "properties": {
        "namespace": {
          "description": "Kubernetes namespace name.",
          "type": "string"
        },
        "serviceAccount": {
          "description": "Kubernetes ServiceAccount name.",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "serviceAccount"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
