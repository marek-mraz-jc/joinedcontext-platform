      "additionalProperties": false,
      "description": "Rate limiting bounds for a service account.",
      "properties": {
        "requestsPerMinute": {
          "description": "Maximum allowed requests per minute.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "requestsPerMinute"
      ],
      "type": "object"
    },
    "ServiceAccountSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`ServiceAccount`][crate::kinds::ServiceAccount] resource (PF-34, PF-35, PF-47).",
      "properties": {
        "credentials": {
          "description": "Authentication credentials registered for this identity.",
          "items": {
            "$ref": "#/definitions/Credential"
          },
          "type": "array"
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/definitions/ServiceAccountLimits"
            },
            {
              "type": "null"
            }
          ],
