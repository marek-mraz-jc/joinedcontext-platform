        },
        "types": {
          "description": "Optional entity types whitelist.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "role",
        "scope"
      ],
      "type": "object"
    },
    "RoleScope": {
      "additionalProperties": false,
      "description": "Target scope of a role grant: exactly one of `contextSpace`, `project`, or `organization`.",
      "properties": {
        "contextSpace": {
          "description": "Context Space scope target.",
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "description": "Organization scope target.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Project scope target.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
