{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AccessLevel": {
      "description": "How a caller reaches an Endpoint, the levels of the per-caller catalogue (T-4503).",
      "oneOf": [
        {
          "description": "Anyone, signed in or not.",
          "enum": [
            "public"
          ],
          "type": "string"
        },
        {
          "description": "Every member of the organization.",
          "enum": [
            "organization"
          ],
          "type": "string"
        },
        {
          "description": "The members of the projects the Endpoint admits.",
          "enum": [
            "project"
          ],
          "type": "string"
        },
        {
          "description": "The ServiceAccounts a grant names.",
          "enum": [
            "grant"
          ],
          "type": "string"
        }
      ]
    },
    "Audience": {
      "description": "Target audience access control setting for an endpoint (EP-14).",
      "oneOf": [
        {
          "description": "Restricted to explicitly listed projects within the organization.",
          "enum": [
            "project-list"
          ],
          "type": "string"
        },
        {
          "description": "Accessible to any authenticated member or service account of the organization.",
          "enum": [
            "organization"
          ],
          "type": "string"
        },
        {
          "description": "Accessible publicly without authentication under the synthetic public role grant.",
          "enum": [
            "public"
          ],
          "type": "string"
        }
      ]
    },
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "component": {
          "description": "The digest of a `wasm` App's server component, taken from the checked bundle and stored by it in the object store; what the WASM host loads and checks (AP-151).",
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "DataTheme": {
      "description": "A theme of the EU data-theme table.",
      "oneOf": [
        {
          "description": "Agriculture, fisheries, forestry and food.",
          "enum": [
            "AGRI"
          ],
          "type": "string"
        },
        {
          "description": "Economy and finance.",
          "enum": [
            "ECON"
          ],
          "type": "string"
        },
        {
          "description": "Education, culture and sport.",
          "enum": [
            "EDUC"
          ],
          "type": "string"
        },
        {
          "description": "Energy.",
          "enum": [
            "ENER"
          ],
          "type": "string"
        },
        {
          "description": "Environment.",
          "enum": [
            "ENVI"
          ],
          "type": "string"
        },
        {
          "description": "Government and public sector.",
          "enum": [
            "GOVE"
          ],
          "type": "string"
        },
        {
          "description": "Health.",
          "enum": [
            "HEAL"
          ],
          "type": "string"
        },
        {
          "description": "International issues.",
          "enum": [
            "INTR"
          ],
          "type": "string"
        },
        {
          "description": "Justice, legal system and public safety.",
          "enum": [
            "JUST"
          ],
          "type": "string"
        },
        {
          "description": "Regions and cities.",
          "enum": [
            "REGI"
          ],
          "type": "string"
        },
        {
          "description": "Population and society.",
          "enum": [
            "SOCI"
          ],
          "type": "string"
        },
        {
          "description": "Science and technology.",
          "enum": [
            "TECH"
          ],
          "type": "string"
        },
        {
          "description": "Transport.",
          "enum": [
            "TRAN"
          ],
          "type": "string"
        }
      ]
    },
    "McpServerSpec": {
      "additionalProperties": false,
      "description": "One named MCP server (MF-53).",
      "properties": {
        "allowedProjects": {
          "description": "The projects a `project-list` server admits; the server's own project when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "audience": {
          "allOf": [
            {
              "$ref": "#/definitions/Audience"
            }
          ],
          "description": "Who may connect: `public`, `organization` or `project-list`. No wider than the narrowest member's own audience; `public` takes the red lane (EP-16)."
        },
        "knowledgeSources": {
          "description": "The `KnowledgeSource`s its `search_documents` searches, up to twenty, each `{source}` of its own project or `{project}/{source}`; each a `visibility: public` source (MF-57).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "members": {
          "description": "The Endpoints the server reads, up to ten, by typed reference (`kind: Endpoint`); a member of another project names its project in `namespace`. At least one without `select`.",
          "items": {
            "$ref": "#/definitions/TypedRef"
          },
          "type": "array"
        },
        "select": {
          "anyOf": [
            {
              "$ref": "#/definitions/Select"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Endpoints it selects beside its members (MF-55)."
        }
      },
      "required": [
        "audience"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        },
        {
          "description": "The platform holds something the repository does not declare, or no longer holds what it does (CC-21, UI-25). Configuration cannot reach this phase — every component reads it from the repository (CC-72) — so it is a space whose seed entities the broker answers differently, and the two resolutions of UI-26 are what a person does about it.",
          "enum": [
            "Drifted"
          ],
          "type": "string"
        }
      ]
    },
    "Select": {
      "additionalProperties": false,
      "description": "Which Endpoints a server selects beside its members (MF-55). An Endpoint is selected when it matches every field given, one value of a field being enough; `select: {}` selects every Endpoint the caller's token and the server's audience admit. The gateway resolves it per call from the caller's own reach, so it only narrows.",
      "properties": {
        "accessLevel": {
          "description": "How the caller reaches the Endpoint; no wider than the server's audience admits.",
          "items": {
            "$ref": "#/definitions/AccessLevel"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "domains": {
          "description": "Smart Data Models domains of the Endpoint's classification, e.g. `Environment` (T-4498).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "projects": {
          "description": "Project names.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "spaces": {
          "description": "Context Spaces as `{project}/{space}`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "themes": {
          "description": "EU data themes of that classification, e.g. `ENVI`.",
          "items": {
            "$ref": "#/definitions/DataTheme"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/definitions/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the build lane published for an `App`, and the only place its artifact is named (AP-13a). Written back by the build lane in the commit that publishes the artifact; an App without it renders no pod, and no other principal may set it (AP-73)."
        },
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        },
        "shard": {
          "description": "The shard of the WASM host a `wasm` App runs on, recorded at its first publish and kept; the edge's route to the App's server is rendered from it (AP-149).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Text": {
      "anyOf": [
        {
          "description": "The form every new manifest writes.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            }
          ],
          "description": "The legacy `{locale: text}` map."
        }
      ],
      "description": "A human label or description (UI-50): one plain string in the author's language. The legacy language map is still read, through release `v0.9`, and resolves to one string."
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version: [`API_VERSION`], or a version [`serves`] accepts for this kind.",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/McpServerSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_McpServerSpec",
  "type": "object"
}
