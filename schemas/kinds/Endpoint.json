{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Audience": {
      "description": "Target audience access control setting for an endpoint (EP-14).",
      "oneOf": [
        {
          "description": "Restricted to explicitly listed projects within the organization.",
          "enum": [
            "project-list"
          ],
          "type": "string"
        },
        {
          "description": "Accessible to any authenticated member or service account of the organization.",
          "enum": [
            "organization"
          ],
          "type": "string"
        },
        {
          "description": "Accessible publicly without authentication under the synthetic public role grant.",
          "enum": [
            "public"
          ],
          "type": "string"
        }
      ]
    },
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Caching": {
      "additionalProperties": false,
      "description": "HTTP caching configuration for endpoint responses.",
      "properties": {
        "maxAgeSeconds": {
          "description": "Maximum cache age in seconds.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "maxAgeSeconds"
      ],
      "type": "object"
    },
    "Catalog": {
      "additionalProperties": false,
      "description": "The catalogue description of one Endpoint (EP-78).",
      "properties": {
        "applicableLegislation": {
          "description": "ELI IRIs of the laws that apply: `dcatap:applicableLegislation`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attribution": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The words the attribution duty asks for, per language: `dct:rights`.",
          "type": "object"
        },
        "contactPoint": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContactPoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where questions about it go: `dcat:contactPoint`, a role address (EP-80)."
        },
        "frequency": {
          "anyOf": [
            {
              "$ref": "#/definitions/Frequency"
            },
            {
              "type": "null"
            }
          ],
          "description": "How often the data changes, from the EU frequency table: `dct:accrualPeriodicity`."
        },
        "keywords": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Keywords per language: `dcat:keyword`.",
          "type": "object"
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/definitions/Licence"
            },
            {
              "type": "null"
            }
          ],
          "description": "The licence, from the EU licence table: `dct:license`."
        },
        "pipelineRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/TypedRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Pipeline of this project that fills the space: `prov:wasGeneratedBy`."
        },
        "publisher": {
          "anyOf": [
            {
              "$ref": "#/definitions/Publisher"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who publishes the dataset: `dct:publisher`."
        },
        "source": {
          "description": "The original open datasets the data comes from: `dct:source`.",
          "items": {
            "$ref": "#/definitions/Source"
          },
          "type": "array"
        },
        "spatial": {
          "description": "NUTS codes or location IRIs: `dct:spatial`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "temporal": {
          "anyOf": [
            {
              "$ref": "#/definitions/Temporal"
            },
            {
              "type": "null"
            }
          ],
          "description": "The period the data covers: `dct:temporal`."
        },
        "themes": {
          "description": "EU data themes: `dcat:theme`.",
          "items": {
            "$ref": "#/definitions/DataTheme"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "CkanPublication": {
      "additionalProperties": false,
      "description": "Publication of one Endpoint as one CKAN dataset (EP-62…EP-65).",
      "properties": {
        "datastore": {
          "anyOf": [
            {
              "$ref": "#/definitions/DataStore"
            },
            {
              "type": "null"
            }
          ],
          "description": "The optional row mirror (EP-65)."
        },
        "instanceRef": {
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ],
          "description": "The `CkanInstance` this Endpoint publishes to."
        },
        "license": {
          "description": "The CKAN licence id the organization chose, such as `cc-by` for CC-BY 4.0. Used when the Endpoint's DCAT-AP record names no `dct:license`, which is the one term the record does not carry (EP-62, EP-63).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The CKAN dataset name; the Endpoint's own name when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "description": "The CKAN organization slug; the instance's default when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instanceRef"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "ContactPoint": {
      "additionalProperties": false,
      "description": "The contact point of a dataset, a `vcard:Kind`.",
      "properties": {
        "email": {
          "description": "A role address, never a person's own (EP-80): `vcard:hasEmail`.",
          "type": "string"
        },
        "name": {
          "description": "The desk's name: `vcard:fn`.",
          "type": "string"
        }
      },
      "required": [
        "email",
        "name"
      ],
      "type": "object"
    },
    "DataStore": {
      "additionalProperties": false,
      "description": "The optional row mirror in the CKAN DataStore (EP-65).",
      "properties": {
        "refresh": {
          "allOf": [
            {
              "$ref": "#/definitions/DataStoreRefresh"
            }
          ],
          "default": "onChange",
          "description": "How the mirror is kept current."
        },
        "representation": {
          "allOf": [
            {
              "$ref": "#/definitions/Representation"
            }
          ],
          "description": "The tabular representation the rows are read through; it must be enabled (EP-44)."
        }
      },
      "required": [
        "representation"
      ],
      "type": "object"
    },
    "DataStoreRefresh": {
      "description": "How often the DataStore mirror is refreshed (EP-65).",
      "oneOf": [
        {
          "description": "Driven by the Endpoint's own subscription: one upsert per changed entity (the default).",
          "enum": [
            "onChange"
          ],
          "type": "string"
        },
        {
          "description": "Reloaded whenever the Endpoint is reconciled, for a space without a subscription.",
          "enum": [
            "onReconcile"
          ],
          "type": "string"
        }
      ]
    },
    "DataTheme": {
      "description": "A theme of the EU data-theme table.",
      "oneOf": [
        {
          "description": "Agriculture, fisheries, forestry and food.",
          "enum": [
            "AGRI"
          ],
          "type": "string"
        },
        {
          "description": "Economy and finance.",
          "enum": [
            "ECON"
          ],
          "type": "string"
        },
        {
          "description": "Education, culture and sport.",
          "enum": [
            "EDUC"
          ],
          "type": "string"
        },
        {
          "description": "Energy.",
          "enum": [
            "ENER"
          ],
          "type": "string"
        },
        {
          "description": "Environment.",
          "enum": [
            "ENVI"
          ],
          "type": "string"
        },
        {
          "description": "Government and public sector.",
          "enum": [
            "GOVE"
          ],
          "type": "string"
        },
        {
          "description": "Health.",
          "enum": [
            "HEAL"
          ],
          "type": "string"
        },
        {
          "description": "International issues.",
          "enum": [
            "INTR"
          ],
          "type": "string"
        },
        {
          "description": "Justice, legal system and public safety.",
          "enum": [
            "JUST"
          ],
          "type": "string"
        },
        {
          "description": "Regions and cities.",
          "enum": [
            "REGI"
          ],
          "type": "string"
        },
        {
          "description": "Population and society.",
          "enum": [
            "SOCI"
          ],
          "type": "string"
        },
        {
          "description": "Science and technology.",
          "enum": [
            "TECH"
          ],
          "type": "string"
        },
        {
          "description": "Transport.",
          "enum": [
            "TRAN"
          ],
          "type": "string"
        }
      ]
    },
    "EndpointRole": {
      "additionalProperties": false,
      "description": "One role an Endpoint gives the callers it admits who match a subject (AP-96, AP-97).",
      "properties": {
        "name": {
          "description": "The role's name, `[a-z][a-z0-9-]{0,31}`; the caller holds [`endpoint_role`] of it.",
          "type": "string"
        },
        "subjects": {
          "description": "Who holds it: `user` by e-mail, `group` by name, never a wildcard.",
          "items": {
            "$ref": "#/definitions/Subject"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "subjects"
      ],
      "type": "object"
    },
    "EndpointSlug": {
      "description": "Cryptographically random endpoint slug with at least 128 bits of entropy (lowercase RFC 4648 base32 without padding, >=26 chars, EP-02)",
      "pattern": "^[a-z2-7]{26,}$",
      "type": "string"
    },
    "EndpointSpec": {
      "additionalProperties": false,
      "description": "Desired specification of an [`Endpoint`][crate::kinds::Endpoint] resource (EP-01..EP-28).",
      "properties": {
        "allowedProjects": {
          "description": "Whitelist of project slugs permitted when audience is `project-list` (EP-14, EP-15).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "audience": {
          "allOf": [
            {
              "$ref": "#/definitions/Audience"
            }
          ],
          "description": "Audience access scope (EP-14)."
        },
        "caching": {
          "anyOf": [
            {
              "$ref": "#/definitions/Caching"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional response caching configuration."
        },
        "callerRole": {
          "description": "Every caller this Endpoint admits holds the role [`endpoint_role`] names for it, on requests through this Endpoint alone (AP-96, AP-97). The App reconciler sets it, so an App's grants never reach another surface of the space.",
          "type": "boolean"
        },
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/definitions/Catalog"
            },
            {
              "type": "null"
            }
          ],
          "description": "What a DCAT-AP catalogue needs beyond the distributions: publisher, contact, licence, themes, coverage, frequency and provenance (EP-78, EP-79)."
        },
        "contextSpaceRef": {
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ],
          "description": "Reference to the underlying ContextSpace."
        },
        "enabledRepresentations": {
          "description": "Set of enabled representation formats (EP-05).",
          "items": {
            "$ref": "#/definitions/Representation"
          },
          "type": "array"
        },
        "fileLimits": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileLimits"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional ceiling on one `file.*` download (EP-44)."
        },
        "mcp": {
          "description": "`false` turns the Endpoint's MCP instance off. Every Endpoint serves `mcp` without listing it, public or internal, gated by its own Policy (EP-24, T-2901); see [`EndpointSpec::served_representations`].",
          "type": [
            "boolean",
            "null"
          ]
        },
        "policyRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Urn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional NGSI-LD Policy URN attached to this endpoint."
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/definitions/Projection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional publication narrowing applied to every representation (EP-61)."
        },
        "projectionRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/TypedRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The named subset of the space's model this Endpoint reads (MP-02): a `ModelProjection` of the same space, intersected with the caller's grants by the gateway, so it narrows and never widens."
        },
        "publish": {
          "anyOf": [
            {
              "$ref": "#/definitions/Publication"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where this Endpoint is published beside its own surface: an open-data catalogue so far (EP-62)."
        },
        "rateLimits": {
          "anyOf": [
            {
              "$ref": "#/definitions/RateLimits"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional rate limiting configuration (EP-20)."
        },
        "roles": {
          "description": "Roles a caller this Endpoint admits holds when a subject matches them, on requests through it alone (AP-96, AP-97).",
          "items": {
            "$ref": "#/definitions/EndpointRole"
          },
          "type": "array"
        },
        "slug": {
          "allOf": [
            {
              "$ref": "#/definitions/EndpointSlug"
            }
          ],
          "description": "Unguessable opaque slug with >= 128 bits of entropy (EP-02)."
        },
        "viewMappingRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/TypedRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "A `Mapping` whose target model this Endpoint serves instead of the space's own (EP-54, DM-51).\n\nThe gateway translates every entity through the Mapping's compiled IR and rewrites `attrs`, `q` and `geoQ` back through its inverse. An Endpoint that carries one is read only: a mapping is invertible per slot, not per entity, so a write in the target model has no source entity to reconstruct."
        }
      },
      "required": [
        "audience",
        "contextSpaceRef",
        "enabledRepresentations",
        "slug"
      ],
      "type": "object"
    },
    "FileLimits": {
      "additionalProperties": false,
      "description": "How much of a `file.*` representation one download may return (EP-44).\n\nThe gateway pages through the broker and stops at the first row that would cross either bound, so a caller gets a refusal rather than a file that is silently short. An absent field leaves the gateway's own ceiling in charge.",
      "properties": {
        "maxFileBytes": {
          "description": "Bytes a single download may return.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maxFileRows": {
          "description": "Rows a single download may return.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Frequency": {
      "description": "An update frequency of the EU frequency table.",
      "oneOf": [
        {
          "description": "Continuous.",
          "enum": [
            "CONT"
          ],
          "type": "string"
        },
        {
          "description": "Hourly.",
          "enum": [
            "HOURLY"
          ],
          "type": "string"
        },
        {
          "description": "Daily.",
          "enum": [
            "DAILY"
          ],
          "type": "string"
        },
        {
          "description": "Weekly.",
          "enum": [
            "WEEKLY"
          ],
          "type": "string"
        },
        {
          "description": "Monthly.",
          "enum": [
            "MONTHLY"
          ],
          "type": "string"
        },
        {
          "description": "Quarterly.",
          "enum": [
            "QUARTERLY"
          ],
          "type": "string"
        },
        {
          "description": "Annual.",
          "enum": [
            "ANNUAL"
          ],
          "type": "string"
        },
        {
          "description": "Irregular.",
          "enum": [
            "IRREG"
          ],
          "type": "string"
        },
        {
          "description": "Never updated.",
          "enum": [
            "NEVER"
          ],
          "type": "string"
        },
        {
          "description": "Unknown.",
          "enum": [
            "UNKNOWN"
          ],
          "type": "string"
        }
      ]
    },
    "Licence": {
      "description": "A licence of the EU licence table whose duties are known (EP-79).",
      "oneOf": [
        {
          "description": "Creative Commons Zero 1.0.",
          "enum": [
            "CC0"
          ],
          "type": "string"
        },
        {
          "description": "Creative Commons Attribution 4.0.",
          "enum": [
            "CC_BY_4_0"
          ],
          "type": "string"
        },
        {
          "description": "Creative Commons Attribution-ShareAlike 4.0.",
          "enum": [
            "CC_BYSA_4_0"
          ],
          "type": "string"
        },
        {
          "description": "Open Data Commons Attribution.",
          "enum": [
            "ODC_BY"
          ],
          "type": "string"
        },
        {
          "description": "Open Data Commons Open Database Licence.",
          "enum": [
            "ODC_ODBL"
          ],
          "type": "string"
        },
        {
          "description": "Open Data Commons Public Domain Dedication and Licence.",
          "enum": [
            "ODC_PDDL"
          ],
          "type": "string"
        }
      ]
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        },
        {
          "description": "The platform holds something the repository does not declare, or no longer holds what it does (CC-21, UI-25). Configuration cannot reach this phase — every component reads it from the repository (CC-72) — so it is a space whose seed entities the broker answers differently, and the two resolutions of UI-26 are what a person does about it.",
          "enum": [
            "Drifted"
          ],
          "type": "string"
        }
      ]
    },
    "Projection": {
      "additionalProperties": false,
      "description": "What this Endpoint never serves, whatever the Policy set allows (EP-61).\n\nA publication decision, not an authorization one: the gateway intersects this list with the caller's policy projection, so an Endpoint can subtract from a grant and never add to it. The same space can therefore be published twice with different amounts of detail without writing a second Policy, and because the subtraction happens where every representation reads its entities, a hidden attribute is missing from the CSV, the GeoJSON, the MCP tool result and the schema surface alike (EP-06, EP-07, EP-47).",
      "properties": {
        "hiddenAttributes": {
          "description": "Attribute names this endpoint removes from every representation.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Publication": {
      "additionalProperties": false,
      "description": "Where an Endpoint is published beside its own surface (EP-62).",
      "properties": {
        "ckan": {
          "anyOf": [
            {
              "$ref": "#/definitions/CkanPublication"
            },
            {
              "type": "null"
            }
          ],
          "description": "Publication to an open-data catalogue."
        }
      },
      "type": "object"
    },
    "Publisher": {
      "additionalProperties": false,
      "description": "The publisher of a dataset, a `foaf:Agent`.",
      "properties": {
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The publisher's name per language: `foaf:name`.",
          "type": "object"
        },
        "uri": {
