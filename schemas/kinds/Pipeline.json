{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Compute": {
      "additionalProperties": false,
      "description": "Compute execution specification (PL-33).",
      "properties": {
        "bloblang": {
          "description": "The inline mapping of a `bloblang` step (PL-41): the reconciler renders it as the last `mapping` processor of the generated `bento.yaml`. Absent means the author keeps the mapping in `bento.yaml`.",
          "type": [
            "string",
            "null"
          ]
        },
        "function": {
          "description": "Entry point function name (for wasm).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/ComputeKind"
            }
          ],
          "description": "Engine kind executing compute logic."
        },
        "mappingRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference to a [`Mapping`][crate::kinds::Mapping] resource."
        },
        "module": {
          "description": "Path or package of the compute module (for wasm).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ComputeKind": {
      "description": "Execution technology category for pipeline compute steps (PL-33).",
      "oneOf": [
        {
          "description": "Inline Bento Bloblang processor.",
          "enum": [
            "bloblang"
          ],
          "type": "string"
        },
        {
          "description": "Compiled LinkML-Map mapping processor (PL-29).",
          "enum": [
            "mapping"
          ],
          "type": "string"
        },
        {
          "description": "Sandboxed WebAssembly WASI module (PL-34).",
          "enum": [
            "wasm"
          ],
          "type": "string"
        },
        {
          "description": "Ephemeral containerized job (PL-35).",
          "enum": [
            "container"
          ],
          "type": "string"
        }
      ]
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "Expiry": {
      "additionalProperties": false,
      "description": "Stale-entity expiry: entities of `types` not modified for `after` are deleted (PL-64).",
      "properties": {
        "after": {
          "description": "Whole hours or days, `1h` to `365d`.",
          "type": "string"
        },
        "types": {
          "description": "The entity types the sweep deletes, one to twenty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "after",
        "types"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "description": "Output specification for derived pipeline computations (PL-32).",
      "properties": {
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/OutputMode"
            }
          ],
          "description": "Write mode applied to target context space."
        },
        "type": {
          "description": "Target entity type name produced.",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "type"
      ],
      "type": "object"
    },
    "OutputMode": {
      "description": "Mutation mode for pipeline output writers (PL-32).",
      "oneOf": [
        {
          "description": "Create or replace complete entity.",
          "enum": [
            "upsert"
          ],
          "type": "string"
        },
        {
          "description": "Update or append attributes onto existing entity.",
          "enum": [
            "update-attrs"
          ],
          "type": "string"
        }
      ]
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        },
        {
          "description": "The platform holds something the repository does not declare, or no longer holds what it does (CC-21, UI-25). Configuration cannot reach this phase — every component reads it from the repository (CC-72) — so it is a space whose seed entities the broker answers differently, and the two resolutions of UI-26 are what a person does about it.",
          "enum": [
            "Drifted"
          ],
          "type": "string"
        }
      ]
    },
    "PipelineClass": {
      "description": "Operational execution class of a data pipeline (PL-04, PL-05).",
      "oneOf": [
        {
          "description": "Reconciler automatically determines class from cadence or input mode (PL-05, PL-26).",
          "enum": [
            "auto"
          ],
          "type": "string"
        },
        {
          "description": "Continuous process hosted inside project pipeline runner deployment.",
          "enum": [
            "resident"
          ],
          "type": "string"
        },
        {
          "description": "Ephemeral Kubernetes CronJob executed periodically.",
          "enum": [
            "scheduled"
          ],
          "type": "string"
        }
      ]
    },
    "PipelineOutput": {
      "additionalProperties": false,
      "description": "One output of a `v1alpha2` pipeline (PL-52): the Endpoint written through and how.",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/OutputMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Write mode; absent is `upsert`."
        },
        "targetEndpoint": {
          "allOf": [
            {
              "$ref": "#/definitions/Urn"
            }
          ],
          "description": "The Endpoint the writes go through (PF-39, PL-18)."
        },
        "type": {
          "description": "The entity type written, when the pipeline names one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "targetEndpoint"
      ],
      "type": "object"
    },
    "PipelineQuotas": {
      "additionalProperties": false,
      "description": "Resource quotas for a pipeline runner (PL-11).",
      "properties": {
        "cpuMillicores": {
          "description": "CPU allocation in millicores.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maxMemoryMb": {
          "description": "Maximum allowed memory allocation in megabytes.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PipelineSource": {
      "additionalProperties": false,
      "description": "Source specification for derived pipelines (PL-31).",
      "properties": {
        "dataSourceRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference to the `DataSource` whose connection becomes this pipeline's Bento input (PL-39, MF-35). Excludes `endpointRef`: a pipeline reads the outside world or the platform's own spaces, not both in one input."
        },
        "endpointRef": {
          "anyOf": [
            {
              "$ref": "#/definitions/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference to source Endpoint for reading context entities."
        },
        "query": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceQuery"
            },
            {
              "type": "null"
            }
          ],
          "description": "Query parameters for pulling entities."
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/definitions/Trigger"
            },
            {
              "type": "null"
            }
          ],
          "description": "Event subscription trigger for resident processing."
        }
      },
      "type": "object"
    },
    "PipelineSpec": {
      "additionalProperties": false,
      "description": "Desired specification of a [`Pipeline`][crate::kinds::Pipeline] resource (PL-01..PL-28).\n\nTwo shapes (PL-54, ADR-N-023): `v1alpha1` holds one `source`, one `compute`, one `output` and `targetEndpoint`; `v1alpha2` holds `sources`, `steps` and `outputs`. The accessors [`PipelineSpec::sources`], [`PipelineSpec::steps`] and [`PipelineSpec::outputs`] read either as the second, so nothing downstream has to know which one a file was written in.",
      "properties": {
        "allowFeedback": {
          "description": "The author knows this resident pipeline triggers itself and accepts it (PL-37).\n\nA derived pipeline whose output type is the type its own subscription watches feeds its own trigger, and the reconciler refuses it. Setting this says the loop is deliberate, which is why PL-37 puts the change in the yellow lane: a person reviews it.",
          "type": "boolean"
        },
        "class": {
          "allOf": [
            {
              "$ref": "#/definitions/PipelineClass"
            }
          ],
          "description": "Operational execution class (PL-04, PL-05)."
        },
        "compute": {
          "anyOf": [
            {
              "$ref": "#/definitions/Compute"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional compute execution specification (PL-33)."
        },
        "enabled": {
          "description": "Whether the pipeline runs (PL-40). `false` pauses it: the reconciler leaves a resident stream out of the runner and suspends a scheduled CronJob, the manifest stays, and a Resume is the flag flipped back. Absent means `true`, and `true` is not written back.",
          "type": "boolean"
        },
        "expiry": {
          "anyOf": [
            {
              "$ref": "#/definitions/Expiry"
            },
            {
              "type": "null"
            }
          ],
          "description": "Deletes the entities its source stopped sending; absent, nothing is deleted (PL-64)."
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/definitions/Output"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional output entity type and write mode."
        },
        "outputs": {
          "description": "Where the result is written, each through its own Endpoint (PL-52, PL-55); `v1alpha2`.",
          "items": {
            "$ref": "#/definitions/PipelineOutput"
          },
          "type": "array"
        },
        "period": {
          "description": "How often the pipeline polls its source, as a Bento duration (`15s`, `5m`).\n\nThe reconciler reads it to pick the class (PL-26) and copies it into the runner's `input.generate.interval` (PL-27). Absent means push-based: an MQTT or subscription input driven by its source rather than by a clock.",
          "type": [
            "string",
            "null"
          ]
        },
        "quotas": {
          "anyOf": [
            {
              "$ref": "#/definitions/PipelineQuotas"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resource quotas allocated to this pipeline runner (PL-11)."
        },
        "schedule": {
          "description": "Standard cron schedule expression for scheduled runs (PL-04, PL-26..PL-28).",
          "type": [
            "string",
            "null"
          ]
        },
        "secretRefs": {
          "description": "Secret references injected into runner environments (PL-14..PL-16).",
          "items": {
            "$ref": "#/definitions/SecretRef"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/PipelineSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional context source query or subscription trigger for derived pipelines (PL-31)."
        },
        "sources": {
          "description": "The inputs, merged by a Bento `broker` when there are several (PL-52, PL-53); `v1alpha2`.",
          "items": {
            "$ref": "#/definitions/PipelineSource"
          },
          "type": "array"
        },
        "steps": {
          "description": "The processors, in the order they run (PL-52); `v1alpha2`.",
          "items": {
            "$ref": "#/definitions/Step"
          },
          "type": "array"
        },
        "targetEndpoint": {
          "anyOf": [
            {
              "$ref": "#/definitions/Urn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Target endpoint URN through which writes occur (PF-39, PL-18); `v1alpha1` only."
        }
      },
      "required": [
        "class"
      ],
      "type": "object"
    },
    "ProcessorStep": {
      "additionalProperties": false,
      "description": "A step that names a runner processor (PL-52).",
      "properties": {
        "processor": {
          "additionalProperties": true,
          "description": "Exactly one entry: the processor's name and its configuration.",
          "type": "object"
        }
      },
      "required": [
        "processor"
      ],
      "type": "object"
    },
    "Ref": {
      "anyOf": [
        {
          "description": "Bare string resource name.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/TypedRef"
            }
          ],
          "description": "Typed reference with kind, name, and optional namespace."
        }
      ],
      "description": "Reference to another resource, either bare name or typed reference (MF-07)."
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "Reference to a credential stored in SOPS or OpenBao (PF-36).\n\n`deny_unknown_fields` is a security control: it rejects inline `value:` or `password:` fields at parse time, enforcing that secrets never appear in Git or manifest files.",
      "properties": {
        "envVar": {
          "description": "Optional environment variable name for injection into runners.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "Optional key within secret.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Secret name in secret store.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "SourceQuery": {
      "additionalProperties": false,
      "description": "NGSI-LD query parameters for pipeline source entity retrieval.",
      "properties": {
        "attrs": {
          "description": "Attributes projection list.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "geoQ": {
          "description": "Geographic query filter string.",
          "type": [
            "string",
            "null"
          ]
        },
        "ids": {
          "description": "The entities to read instead of the whole type (PL-42): PF-42 URNs whose `{Type}` is `type` when both are set. Rendered as the `id=` parameter of the fetch.",
          "items": {
            "$ref": "#/definitions/Urn"
          },
          "type": "array"
        },
        "q": {
          "description": "Entity query filter string.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopeQ": {
          "description": "Scope query filter string.",
          "type": [
            "string",
            "null"
          ]
        },
        "temporalQ": {
          "anyOf": [
            {
              "$ref": "#/definitions/TemporalWindow"
            },
            {
              "type": "null"
            }
          ],
          "description": "Temporal window constraint."
        },
        "type": {
          "description": "Target entity type short name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/definitions/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the build lane published for an `App`, and the only place its artifact is named (AP-13a). Written back by the build lane in the commit that publishes the artifact; an App without it renders no pod, and no other principal may set it (AP-73)."
        },
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "Step": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/definitions/ProcessorStep"
            }
          ],
          "description": "`processor: { <name>: <config> }`."
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/Compute"
            }
          ],
          "description": "`kind: bloblang | mapping | wasm | container` with that kind's fields."
        }
      ],
      "description": "One step of a `v1alpha2` pipeline (PL-52): a compute kind of PL-33, or one processor the pinned runner ships, its configuration verbatim in the processor's own field names."
    },
    "SubscriptionTrigger": {
      "additionalProperties": false,
      "description": "Subscription configuration triggering pipeline execution.",
      "properties": {
        "type": {
          "description": "Target entity type name.",
          "type": "string"
        },
        "watchedAttributes": {
          "description": "Whitelist of watched attribute names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "TemporalWindow": {
      "additionalProperties": false,
      "description": "ISO 8601 temporal window for source queries.",
      "properties": {
        "window": {
          "description": "ISO 8601 duration string (e.g. `P1D`).",
          "type": "string"
        }
      },
      "required": [
        "window"
      ],
      "type": "object"
    },
    "Text": {
      "anyOf": [
        {
          "description": "The form every new manifest writes.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            }
          ],
          "description": "The legacy `{locale: text}` map."
        }
      ],
      "description": "A human label or description (UI-50): one plain string in the author's language. The legacy language map is still read, through release `v0.9`, and resolves to one string."
    },
    "Trigger": {
      "additionalProperties": false,
      "description": "Subscription trigger for resident pipelines (PL-31).",
      "properties": {
        "subscription": {
          "allOf": [
            {
              "$ref": "#/definitions/SubscriptionTrigger"
            }
          ],
          "description": "Underlying context subscription details."
        }
      },
      "required": [
        "subscription"
      ],
      "type": "object"
    },
    "TypedRef": {
      "additionalProperties": false,
      "description": "Structured typed resource reference (MF-07).",
      "properties": {
        "kind": {
          "description": "Target resource kind.",
          "type": "string"
        },
        "name": {
          "description": "Target resource name.",
          "type": "string"
        },
        "namespace": {
          "description": "Target resource namespace (defaults to caller namespace if omitted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "Urn": {
      "description": "NGSI-LD entity URN conforming to ADR 001 / PF-42: urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}",
      "pattern": "^urn:ngsi-ld:[A-Z][A-Za-z0-9]{1,63}:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+:[a-z0-9][a-z0-9-]{0,62}:[A-Za-z0-9._~-]{1,128}$",
      "type": "string"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version: [`API_VERSION`], or a version [`serves`] accepts for this kind.",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
