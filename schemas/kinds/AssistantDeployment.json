{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AssistantDeploymentSpec": {
      "additionalProperties": false,
      "description": "Desired specification of an [`AssistantDeployment`][crate::kinds::AssistantDeployment] (MF-52).",
      "properties": {
        "allowedOrigins": {
          "description": "The pages it may be placed on, each `https://host[:port]`; no wildcard, no path.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/definitions/Budget"
            },
            {
              "type": "null"
            }
          ],
          "description": "How much it may spend; required on every channel but `internal`."
        },
        "channel": {
          "allOf": [
            {
              "$ref": "#/definitions/Channel"
            }
          ],
          "description": "`public`, `internal`, `ckan` or `iframe`."
        },
        "connectors": {
          "description": "The Endpoints of this project whose MCP tools it may call.",
          "items": {
            "$ref": "#/definitions/Connector"
          },
          "type": "array"
        },
        "languages": {
          "description": "The languages it answers in, as ISO 639-1 codes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "publicId": {
          "description": "The id in the widget's address, `/w/{publicId}`; a DNS label.",
          "type": "string"
        },
        "rateLimit": {
          "anyOf": [
            {
              "$ref": "#/definitions/RateLimit"
            },
            {
              "type": "null"
            }
          ],
          "description": "How often it answers; required on every channel but `internal`."
        },
        "sandbox": {
          "default": false,
          "description": "Whether it may filter a large tool result with a script in `jc-functions`; default false.",
          "type": "boolean"
        },
        "sources": {
          "description": "The `KnowledgeSource`s of this project it answers from.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "systemPrompt": {
          "description": "What the assistant is told before every conversation; at most 8,000 characters.",
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "anyOf": [
            {
              "$ref": "#/definitions/Theme"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the chat looks."
        }
      },
      "required": [
        "channel",
        "publicId"
      ],
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "How many model tokens the deployment may spend; `jc-agent-proxy` holds it to this.",
      "properties": {
        "tokensPerConversation": {
          "description": "Tokens one conversation may spend; at least 1 and no more than a day's.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "tokensPerDay": {
          "description": "Tokens per day across all conversations; 1 to 100,000,000.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "tokensPerConversation",
        "tokensPerDay"
      ],
      "type": "object"
    },
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "component": {
          "description": "The digest of a `wasm` App's server component, taken from the checked bundle and stored by it in the object store; what the WASM host loads and checks (AP-151).",
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Channel": {
      "description": "Where a deployment answers.",
      "oneOf": [
        {
          "description": "Anyone, on the allowed origins.",
          "enum": [
            "public"
          ],
          "type": "string"
        },
        {
          "description": "Signed-in people of the organization, in the Portal.",
          "enum": [
            "internal"
          ],
          "type": "string"
        },
        {
          "description": "Visitors of the CKAN catalogue.",
          "enum": [
            "ckan"
          ],
          "type": "string"
        },
        {
          "description": "An iframe on the allowed origins.",
          "enum": [
            "iframe"
          ],
          "type": "string"
        }
      ]
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "Connector": {
      "additionalProperties": false,
      "description": "One Endpoint of the project whose MCP tools the assistant may call.",
      "properties": {
        "endpoint": {
          "description": "The Endpoint's `metadata.name` in this project.",
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 20,
          "description": "How long one tool call may take, in seconds; 1 to 120, default 20.",
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "tools": {
          "description": "The tools of its MCP surface the assistant may call; at least one.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "endpoint",
        "tools"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        },
        {
          "description": "The platform holds something the repository does not declare, or no longer holds what it does (CC-21, UI-25). Configuration cannot reach this phase — every component reads it from the repository (CC-72) — so it is a space whose seed entities the broker answers differently, and the two resolutions of UI-26 are what a person does about it.",
          "enum": [
            "Drifted"
          ],
          "type": "string"
        }
      ]
    },
    "RateLimit": {
      "additionalProperties": false,
      "description": "How often the deployment answers.",
      "properties": {
        "perClientPerMinute": {
          "description": "Questions per minute from one client; 1 to 120.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "requestsPerMinute": {
          "description": "Questions per minute across everyone; 1 to 600.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "perClientPerMinute",
        "requestsPerMinute"
      ],
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/definitions/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the build lane published for an `App`, and the only place its artifact is named (AP-13a). Written back by the build lane in the commit that publishes the artifact; an App without it renders no pod, and no other principal may set it (AP-73)."
        },
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        },
        "shard": {
          "description": "The shard of the WASM host a `wasm` App runs on, recorded at its first publish and kept; the edge's route to the App's server is rendered from it (AP-149).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Text": {
      "anyOf": [
        {
          "description": "The form every new manifest writes.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            }
          ],
          "description": "The legacy `{locale: text}` map."
        }
      ],
      "description": "A human label or description (UI-50): one plain string in the author's language. The legacy language map is still read, through release `v0.9`, and resolves to one string."
    },
    "Theme": {
      "additionalProperties": false,
      "description": "How the chat looks where it is placed.",
      "properties": {
        "greeting": {
          "description": "The first line the chat shows, at most 500 characters.",
          "type": [
            "string",
            "null"
          ]
        },
        "primaryColor": {
          "description": "The accent colour, `#rrggbb`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version: [`API_VERSION`], or a version [`serves`] accepts for this kind.",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/AssistantDeploymentSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_AssistantDeploymentSpec",
  "type": "object"
}
