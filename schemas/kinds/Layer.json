{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "ColorBy": {
      "additionalProperties": false,
      "description": "Colour by one numeric property over a domain (UI-18).",
      "properties": {
        "domain": {
          "description": "`[min, max]` of the property mapped onto the ramp.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "palette": {
          "description": "A ColorBrewer ramp name, e.g. `YlOrRd`; the Portal's default when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "property": {
          "description": "The property read from every feature.",
          "type": "string"
        }
      },
      "required": [
        "property"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "LayerFilter": {
      "additionalProperties": false,
      "description": "The static NGSI-LD filter every request of the layer carries (UI-18, UI-22).",
      "properties": {
        "geoQ": {
          "description": "A fixed `geoQ`; the map adds its own viewport bbox on top (UI-22).",
          "type": [
            "string",
            "null"
          ]
        },
        "q": {
          "description": "The `q` expression, e.g. `pm10>0`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopeQ": {
          "description": "The `scopeQ` expression, e.g. `/geo/FI/HKI/#`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LayerSpec": {
      "additionalProperties": false,
      "description": "`spec` of a Layer (UI-18).",
      "properties": {
        "colorBy": {
          "anyOf": [
            {
              "$ref": "#/definitions/ColorBy"
            },
            {
              "type": "null"
            }
          ],
          "description": "The colour encoding."
        },
        "entityType": {
          "description": "The NGSI-LD entity type it shows.",
          "type": "string"
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/definitions/LayerFilter"
            },
            {
              "type": "null"
            }
          ],
          "description": "The static filter."
        },
        "popupProperties": {
          "description": "The properties a click shows, in order; the first few of the feature when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sizeBy": {
          "anyOf": [
            {
              "$ref": "#/definitions/SizeBy"
            },
            {
              "type": "null"
            }
          ],
          "description": "The size encoding."
        },
        "sourceEndpointRef": {
          "description": "The Endpoint of the same project the layer reads through, by `metadata.name`.",
          "type": "string"
        },
        "style": {
          "allOf": [
            {
              "$ref": "#/definitions/LayerStyle"
            }
          ],
          "default": "circle",
          "description": "How it draws."
        },
        "visible": {
          "description": "Drawn when the dashboard opens; `false` leaves it in the legend, switched off.",
          "type": "boolean"
        }
      },
      "required": [
        "entityType",
        "sourceEndpointRef"
      ],
      "type": "object"
    },
    "LayerStyle": {
      "description": "How a layer draws (UI-20, UI-21): the three MapLibre styles and the aggregations only deck.gl renders; `icon` draws as `circle` until the Portal has an icon renderer.",
      "oneOf": [
        {
          "description": "A point per entity.",
          "enum": [
            "circle"
          ],
          "type": "string"
        },
        {
          "description": "A line per entity.",
          "enum": [
            "line"
          ],
          "type": "string"
        },
        {
          "description": "A filled polygon per entity.",
          "enum": [
            "fill"
          ],
          "type": "string"
        },
        {
          "description": "A density surface over the points.",
          "enum": [
            "heatmap"
          ],
          "type": "string"
        },
        {
          "description": "Hexagonal bins over the points.",
          "enum": [
            "hexagon"
          ],
          "type": "string"
        },
        {
          "description": "A symbol per entity.",
          "enum": [
            "icon"
          ],
          "type": "string"
        }
      ]
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Phase": {
      "description": "Lifecycle phase enumeration.",
      "oneOf": [
        {
          "description": "Resource manifest is in draft state.",
          "enum": [
            "Draft"
          ],
          "type": "string"
        },
        {
          "description": "Resource is pending review or approval.",
          "enum": [
            "Pending"
          ],
          "type": "string"
        },
        {
          "description": "Resource deployment is in progress.",
          "enum": [
            "Deploying"
          ],
          "type": "string"
        },
        {
          "description": "Resource is live and active in cluster.",
          "enum": [
            "Live"
          ],
          "type": "string"
        },
        {
          "description": "Reconciliation error.",
          "enum": [
            "Error"
          ],
          "type": "string"
        },
        {
          "description": "The platform holds something the repository does not declare, or no longer holds what it does (CC-21, UI-25). Configuration cannot reach this phase — every component reads it from the repository (CC-72) — so it is a space whose seed entities the broker answers differently, and the two resolutions of UI-26 are what a person does about it.",
          "enum": [
            "Drifted"
          ],
          "type": "string"
        }
      ]
    },
    "SizeBy": {
      "additionalProperties": false,
      "description": "Size by one numeric property over a pixel range (UI-18).",
      "properties": {
        "property": {
          "description": "The property read from every feature.",
          "type": "string"
        },
        "range": {
          "description": "`[min, max]` radius in pixels.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "property"
      ],
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "Server-computed lifecycle and reconciliation status (MF-04). Never stored in Git.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/definitions/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the build lane published for an `App`, and the only place its artifact is named (AP-13a). Written back by the build lane in the commit that publishes the artifact; an App without it renders no pod, and no other principal may set it (AP-73)."
        },
        "conditions": {
          "description": "Reconciler condition transitions.",
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "observedRevision": {
          "description": "Git commit revision observed during reconciliation.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/Phase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current lifecycle phase."
        }
      },
      "type": "object"
    },
    "Text": {
      "anyOf": [
        {
          "description": "The form every new manifest writes.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/MultiLanguageMap"
            }
          ],
          "description": "The legacy `{locale: text}` map."
        }
      ],
      "description": "A human label or description (UI-50): one plain string in the author's language. The legacy language map is still read, through release `v0.9`, and resolves to one string."
    }
  },
  "description": "Kubernetes-style resource envelope (MF-01..MF-04).",
  "properties": {
    "apiVersion": {
      "description": "API version: [`API_VERSION`], or a version [`serves`] accepts for this kind.",
      "type": "string"
    },
    "kind": {
      "description": "Resource kind name (must match [`Kind::KIND`]).",
      "type": "string"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/definitions/ObjectMeta"
        }
      ],
      "description": "Metadata identifying and labeling the resource."
    },
    "spec": {
      "allOf": [
        {
          "$ref": "#/definitions/LayerSpec"
        }
      ],
      "description": "Desired spec state."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/Status"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-computed status. Stripped during export and serialization."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "ResourceEnvelope_for_LayerSpec",
  "type": "object"
}
