{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AppAccess": {
      "additionalProperties": false,
      "description": "Who holds one role of an App (AP-91).",
      "properties": {
        "role": {
          "description": "A role of `spec.roles`.",
          "type": "string"
        },
        "subjects": {
          "description": "`user` by e-mail, `group` by the name of a `Group` manifest (PF-62, PF-64).",
          "items": {
            "$ref": "#/definitions/Subject"
          },
          "type": "array"
        }
      },
      "required": [
        "role",
        "subjects"
      ],
      "type": "object"
    },
    "AppClass": {
      "description": "How an app is built and served (AP-01).",
      "oneOf": [
        {
          "description": "A built front end served from the Portal static host, acting with the user's token (AP-07, AP-14).",
          "enum": [
            "static"
          ],
          "type": "string"
        },
        {
          "description": "A backend running in the instance namespace with its own service account (AP-08, AP-15).",
          "enum": [
            "service"
          ],
          "type": "string"
        },
        {
          "description": "Backend and front end in one image.",
          "enum": [
            "fullstack"
          ],
          "type": "string"
        }
      ]
    },
    "AppEgress": {
      "additionalProperties": false,
      "description": "One destination a server pod reaches besides its endpoint (AP-134). A NetworkPolicy matches addresses, never names, so a host name has no place here (ADR-N-037).",
      "properties": {
        "cidr": {
          "description": "An IPv4 or IPv6 network, `203.0.113.0/24`, with no host bits set; never `/0`.",
          "type": "string"
        },
        "ports": {
          "description": "The TCP ports the pod may reach there, at least one.",
          "items": {
            "format": "uint16",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "cidr",
        "ports"
      ],
      "type": "object"
    },
    "AppLifecycle": {
      "description": "Lifecycle state of an app (AP-18, AP-19, AP-20).",
      "oneOf": [
        {
          "description": "Being written; not deployed.",
          "enum": [
            "draft"
          ],
          "type": "string"
        },
        {
          "description": "Bound to a sandbox space, reachable by the author and reviewers only (AP-19).",
          "enum": [
            "preview"
          ],
          "type": "string"
        },
        {
          "description": "Bound to the real space and reachable by its `visibility` audience (AP-18).",
          "enum": [
            "published"
          ],
          "type": "string"
        },
        {
          "description": "Withdrawn; kept for the record.",
          "enum": [
            "retired"
          ],
          "type": "string"
        }
      ]
    },
    "AppLimits": {
      "additionalProperties": false,
      "description": "Per-app runtime limits enforced on its own endpoint (AP-17).",
      "properties": {
        "maxFileRows": {
          "description": "Rows a single file representation download may return.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requestsPerMinute": {
          "description": "Requests per minute allowed on the app endpoint.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AppRole": {
      "additionalProperties": false,
      "description": "One role a person can hold in an App (AP-90).",
      "properties": {
        "description": {
          "description": "What a person holding it may do, for whoever adds a member.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "`[a-z][a-z0-9-]{0,31}`, unique in the App.",
          "type": "string"
        },
        "title": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The role's name per locale, as the App page and the `403` page show it.",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "AppSource": {
      "additionalProperties": false,
      "description": "Where the app's source lives; exactly one member is set (AP-02).",
      "properties": {
        "git": {
          "anyOf": [
            {
              "$ref": "#/definitions/GitSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "A repository of the same forge (AP-02)."
        },
        "path": {
          "description": "Path beside the manifest in the org repository.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AppSpec": {
      "additionalProperties": false,
      "description": "Desired specification of an [`App`][crate::kinds::App] resource (AP-01..AP-20).",
      "properties": {
        "access": {
          "description": "Who holds each role (AP-91).",
          "items": {
            "$ref": "#/definitions/AppAccess"
          },
          "type": "array"
        },
        "build": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Toolchain versions the build lane builds with; `{}` on a static app is no build step (AP-11, AP-83).",
          "type": "object"
        },
        "csp": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContentSecurityPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content Security Policy of the served app (AP-12)."
        },
        "dataNeeds": {
          "description": "What the app needs to read or write; the reconciler renders its Endpoint and Policies from this (AP-04, AP-05).",
          "items": {
            "$ref": "#/definitions/DataNeed"
          },
          "type": "array"
        },
        "egress": {
          "description": "Where a server pod may connect besides its endpoint, by address only; declaring one takes the red lane (AP-134).",
          "items": {
            "$ref": "#/definitions/AppEgress"
          },
          "type": "array"
        },
        "embeddable": {
          "default": false,
          "description": "Whether the Portal may embed the app in a frame (AP-12).",
          "type": "boolean"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/AppClass"
            }
          ],
          "description": "How the app is built and served; `spec.kind` in the manifest (AP-01)."
        },
        "lifecycle": {
          "allOf": [
            {
              "$ref": "#/definitions/AppLifecycle"
            }
          ],
          "default": "draft",
          "description": "Lifecycle state; a manifest without one is a draft (AP-18)."
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/definitions/AppLimits"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-app rate limits (AP-17)."
        },
        "roles": {
          "description": "The roles a person can hold in the app (AP-90).",
          "items": {
            "$ref": "#/definitions/AppRole"
          },
          "type": "array"
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/definitions/AppSource"
            }
          ],
          "description": "Where the source lives (AP-02)."
        },
        "visibility": {
          "allOf": [
            {
              "$ref": "#/definitions/AppVisibility"
            }
          ],
          "default": "project",
          "description": "Who may reach the published app (AP-18); `project` when the manifest does not say, so an app nobody opened up asks for a login (AP-120)."
        }
      },
      "required": [
        "build",
        "dataNeeds",
        "kind",
        "source"
      ],
      "type": "object"
    },
    "AppVisibility": {
      "description": "Who may reach a published app (AP-18). A login by default: `project` (AP-120).",
      "oneOf": [
        {
          "description": "Only the author.",
          "enum": [
            "private"
          ],
          "type": "string"
        },
        {
          "description": "Members of the owning project.",
          "enum": [
            "project"
          ],
          "type": "string"
        },
        {
          "description": "Anyone in the organization.",
          "enum": [
            "organization"
          ],
          "type": "string"
        },
        {
          "description": "Everyone, unauthenticated.",
          "enum": [
            "public"
          ],
          "type": "string"
        },
        {
          "description": "Only a signed-in person holding one of the app's roles (AP-93, AP-94).",
          "enum": [
            "roles"
          ],
          "type": "string"
        }
      ]
    },
    "Build": {
      "additionalProperties": false,
      "description": "The artifact one build of an `App` published, as the build lane writes it back (AP-13a).",
      "properties": {
        "builtAt": {
          "description": "When the build lane published it.",
          "format": "date-time",
          "type": "string"
        },
        "commit": {
          "description": "The commit of the source the artifact was built from, 7 to 40 lowercase hexadecimal characters.",
          "type": "string"
        },
        "digest": {
          "description": "The artifact's digest, `sha256:` and 64 lowercase hexadecimal characters. The reconciler deploys this and nothing else (AP-72).",
          "type": "string"
        },
        "sdkVersion": {
          "description": "The version of the app SDK the artifact was built against.",
          "type": "string"
        }
      },
      "required": [
        "builtAt",
        "commit",
        "digest",
        "sdkVersion"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Status condition entry.",
      "properties": {
        "lastTransitionTime": {
          "description": "Last transition timestamp.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Machine-readable reason code.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Status value (\"True\", \"False\", \"Unknown\").",
          "type": "string"
        },
        "type": {
          "description": "Type of condition (e.g. Reconciled, Ready).",
          "type": "string"
        }
      },
      "required": [
        "status",
        "type"
      ],
      "type": "object"
    },
    "ContentSecurityPolicy": {
      "additionalProperties": false,
      "description": "Content Security Policy of a served app (AP-12).",
      "properties": {
        "connectSrc": {
          "description": "`connect-src`; only `self` and https origins, never `*` (AP-12).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frameAncestors": {
          "description": "`frame-ancestors`; defaults to `none` (AP-12).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frameSrc": {
          "description": "`frame-src` beyond `self`; only https origins, never `*` (AP-12).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DataNeed": {
      "additionalProperties": false,
      "description": "One declared data need, the input the reconciler renders a Policy from (AP-04, AP-05).",
      "properties": {
        "attrs": {
          "description": "Attributes the app needs; empty means every readable attribute of those types.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contextSpaceRef": {
          "allOf": [
            {
              "$ref": "#/definitions/Ref"
            }
          ],
          "description": "The context space the app reads."
        },
        "geoQ": {
          "anyOf": [
            {
              "$ref": "#/definitions/GeoConstraint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Geographic narrowing."
        },
        "operations": {
          "description": "CIM 009 clause 4.20 operation names the app performs (R8).",
          "items": {
            "$ref": "#/definitions/OperationRef"
          },
          "type": "array"
        },
        "q": {
          "description": "NGSI-LD query narrowing the readable set.",
          "type": [
            "string",
            "null"
          ]
        },
        "representations": {
          "description": "Representations of the rendered endpoint this need contributes (AP-05, EP-08).",
          "items": {
            "$ref": "#/definitions/Representation"
          },
          "type": "array"
        },
        "roles": {
          "description": "The app roles this need is granted to; empty means every caller the endpoint admits (AP-96).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scopeQ": {
          "description": "Scope query narrowing the readable set.",
          "type": [
            "string",
            "null"
          ]
        },
        "temporalQ": {
          "anyOf": [
            {
              "$ref": "#/definitions/TemporalConstraint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Temporal narrowing."
        },
        "types": {
          "description": "NGSI-LD entity types the app needs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contextSpaceRef",
        "operations",
        "types"
      ],
      "type": "object"
    },
    "GeoConstraint": {
      "additionalProperties": false,
      "description": "Geographic narrowing of a data need, e.g. `{ within: { scopeRef: /geo/SK/BB } }` (AP-05).",
      "properties": {
        "within": {
          "allOf": [
            {
              "$ref": "#/definitions/GeoWithin"
            }
          ],
          "description": "Scope tree the app may read inside."
        }
      },
      "required": [
        "within"
      ],
      "type": "object"
    },
    "GeoWithin": {
      "additionalProperties": false,
      "description": "The scope a [`GeoConstraint`] confines the app to (ADR 005).",
      "properties": {
        "scopeRef": {
          "description": "Absolute scope string, e.g. `/geo/SK/BB`.",
          "type": "string"
        }
      },
      "required": [
        "scopeRef"
      ],
      "type": "object"
    },
    "GitSource": {
      "additionalProperties": false,
      "description": "A source repository on the organization's own forge (AP-02).",
      "properties": {
        "path": {
          "description": "Subdirectory holding the app.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "Branch, tag or commit.",
          "type": "string"
        },
        "url": {
          "description": "Clone URL on the organization's forge; `https://` only.",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "url"
      ],
      "type": "object"
    },
    "MultiLanguageMap": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Multi-language map keyed by ISO 639-1 two-letter lowercase language codes",
      "propertyNames": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "description": "Metadata envelope attached to every platform resource (MF-02).",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for provenance and ownership (MF-08).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable description: one string, or the legacy map per locale (UI-50, PF-24)."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for filtering (MF-10).",
          "type": "object"
        },
        "name": {
          "description": "Resource name (DNS-1123 label).",
          "type": "string"
        },
        "namespace": {
          "description": "Resource namespace (\"org\" or project slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable title: one string, or the legacy map per locale (UI-50, PF-24)."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Operation": {
      "description": "Table 4.20-1: every named distributed API operation in ETSI GS CIM 009 (R8).\n\nClosed enum ensures no proprietary verbs (`upsertEntity`, `read`, `write`) are accepted, satisfying the strict R8 CIM 009 vocabulary guarantee.",
      "oneOf": [
        {
          "description": "Create entity (`POST /entities`).",
          "enum": [
            "createEntity"
          ],
          "type": "string"
        },
        {
          "description": "Update entity (`PATCH /entities/{id}`).",
          "enum": [
            "updateEntity"
          ],
          "type": "string"
        },
        {
          "description": "Append entity attributes (`POST /entities/{id}/attrs`).",
          "enum": [
            "appendAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Update entity attributes (`PATCH /entities/{id}/attrs`).",
          "enum": [
            "updateAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Delete entity attributes (`DELETE /entities/{id}/attrs/{attr}`).",
          "enum": [
            "deleteAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Delete entity (`DELETE /entities/{id}`).",
          "enum": [
            "deleteEntity"
          ],
          "type": "string"
        },
        {
          "description": "Batch create entities (`POST /entityOperations/create`).",
          "enum": [
            "createBatch"
          ],
          "type": "string"
        },
        {
          "description": "Batch upsert entities (`POST /entityOperations/upsert`).",
          "enum": [
            "upsertBatch"
          ],
          "type": "string"
        },
        {
          "description": "Batch update entities (`POST /entityOperations/update`).",
          "enum": [
            "updateBatch"
          ],
          "type": "string"
        },
        {
          "description": "Batch delete entities (`POST /entityOperations/delete`).",
          "enum": [
            "deleteBatch"
          ],
          "type": "string"
        },
        {
          "description": "Upsert temporal entity attributes (`POST /temporal/entities/{id}/attrs`).",
          "enum": [
            "upsertTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Append temporal entity attributes (`POST /temporal/entities/{id}/attrs`).",
          "enum": [
            "appendAttrsTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Delete temporal entity attributes (`DELETE /temporal/entities/{id}/attrs/{attr}`).",
          "enum": [
            "deleteAttrsTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Update temporal attribute instance (`PATCH /temporal/entities/{id}/attrs/{attr}/{instance}`).",
          "enum": [
            "updateAttrInstanceTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Delete temporal attribute instance (`DELETE /temporal/entities/{id}/attrs/{attr}/{instance}`).",
          "enum": [
            "deleteAttrInstanceTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Delete temporal entity (`DELETE /temporal/entities/{id}`).",
          "enum": [
            "deleteTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Merge entity (`PATCH /entities/{id}`).",
          "enum": [
            "mergeEntity"
          ],
          "type": "string"
        },
        {
          "description": "Replace entity (`PUT /entities/{id}`).",
          "enum": [
            "replaceEntity"
          ],
          "type": "string"
        },
        {
          "description": "Replace entity attributes (`PATCH /entities/{id}/attrs`).",
          "enum": [
            "replaceAttrs"
          ],
          "type": "string"
        },
        {
          "description": "Batch merge entities (`POST /entityOperations/merge`).",
          "enum": [
            "mergeBatch"
          ],
          "type": "string"
        },
        {
          "description": "Purge entity permanently (`DELETE /entities/{id}?purge=true`).",
          "enum": [
            "purgeEntity"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve single entity (`GET /entities/{id}`).",
          "enum": [
            "retrieveEntity"
          ],
          "type": "string"
        },
        {
          "description": "Query entities (`GET /entities` or `POST /entityOperations/query`).",
          "enum": [
            "queryEntity"
          ],
          "type": "string"
        },
        {
          "description": "Batch query entities (`POST /entityOperations/query`).",
          "enum": [
            "queryBatch"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve temporal entity (`GET /temporal/entities/{id}`).",
          "enum": [
            "retrieveTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Query temporal entities (`GET /temporal/entities`).",
          "enum": [
            "queryTemporal"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve entity types list (`GET /types`).",
          "enum": [
            "retrieveEntityTypes"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve details of the available entity types (`GET /types?details=true`).",
          "enum": [
            "retrieveEntityTypeDetails"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve one entity type's information (`GET /types/{type}`).",
          "enum": [
            "retrieveEntityTypeInfo"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve attribute types list (`GET /attributes`).",
          "enum": [
            "retrieveAttrTypes"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve details of the available attributes (`GET /attributes?details=true`).",
          "enum": [
            "retrieveAttrTypeDetails"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve one attribute's information (`GET /attributes/{attr}`).",
          "enum": [
            "retrieveAttrTypeInfo"
          ],
          "type": "string"
        },
        {
          "description": "Create context subscription (`POST /subscriptions`).",
          "enum": [
            "createSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Update context subscription (`PATCH /subscriptions/{id}`).",
          "enum": [
            "updateSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve context subscription (`GET /subscriptions/{id}`).",
          "enum": [
            "retrieveSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Query context subscriptions (`GET /subscriptions`).",
          "enum": [
            "querySubscription"
          ],
          "type": "string"
        },
        {
          "description": "Delete context subscription (`DELETE /subscriptions/{id}`).",
          "enum": [
            "deleteSubscription"
          ],
          "type": "string"
        },
        {
          "description": "Retrieve context entity map (`GET /entityMaps/{id}`).",
          "enum": [
            "retrieveEntityMap"
          ],
          "type": "string"
        },
        {
          "description": "Update context entity map (`PATCH /entityMaps/{id}`).",
          "enum": [
            "updateEntityMap"
          ],
          "type": "string"
        },
        {
          "description": "Delete context entity map (`DELETE /entityMaps/{id}`).",
          "enum": [
            "deleteEntityMap"
          ],
          "type": "string"
        },
        {
          "description": "Create entity map query on entities.",
          "enum": [
            "createEntityMapQueryEntity"
          ],
          "type": "string"
        },
        {
