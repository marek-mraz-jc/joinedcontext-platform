    { "group": "link", "attributes": ["url", "image"] },
    { "group": "other", "attributes": ["description"] },
    { "group": "meta", "attributes": ["source", "dataProvider", "owner", "seeAlso", "dateCreated", "dateModified", "dateIssued", "dateRetrieved", "type"] },
