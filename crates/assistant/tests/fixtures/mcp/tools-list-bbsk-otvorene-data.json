 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "Describe schema"
  },
  "description": "Inspect the data model of this context space, narrowed to the caller's grant. Read linkml first: it carries the classes, their slots and their descriptions in one small document. The default `summary` lists every artifact with its size and digest and says which to read.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "entityType": {
     "description": "One entity type, or the list of the classes you need",
     "oneOf": [
      {
       "maxLength": 256,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
       "type": "string"
      },
      {
       "items": {
        "maxLength": 256,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
        "type": "string"
       },
       "maxItems": 64,
       "minItems": 1,
       "type": "array"
      }
     ]
    },
    "format": {
     "description": "summary (the default) lists the models and every artifact with its format, size and digest, linkml first; the others render one, the text formalisms as {format, mediaType, document}; qb only where the model is a data cube",
     "enum": [
      "summary",
      "json-schema",
      "context",
      "linkml",
      "shacl",
      "owl",
      "rdf",
      "markdown",
      "qb"
     ],
     "type": "string"
    },
    "version": {
     "description": "Model major version",
     "minimum": 1,
     "type": "integer"
    }
   },
   "type": "object"
  },
  "name": "describe_schema",
  "outputSchema": {
   "properties": {
    "jc:source": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "restricted": {
     "type": "boolean"
    },
    "schema": {}
   },
   "required": [
    "schema"
   ],
   "type": "object"
  },
  "title": "Describe schema"
 }
