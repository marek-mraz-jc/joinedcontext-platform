      "permissions",
      "odrl",
      "grant-ast"
     ],
     "type": "string"
    }
   },
   "type": "object"
  },
  "name": "describe_access",
  "outputSchema": {
   "properties": {
    "access": {},
    "jc:source": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "restricted": {
     "type": "boolean"
    }
   },
   "required": [
    "access"
   ],
   "type": "object"
  },
  "title": "Describe access"
