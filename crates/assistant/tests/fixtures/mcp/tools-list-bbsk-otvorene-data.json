 {
  "annotations": {
   "destructiveHint": false,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "Query entities"
  },
  "description": "Query Entities (TS 104 175 10.4.3): by type, id, q, scopeQ or area, a page at a time. Give at least one of type, attrs, q, georel or local.\n\nQuery guide, per type:\nKeyPerformanceIndicator: no time axis. Place location; near a point: type=KeyPerformanceIndicator, georel=near;maxDistance==2000, geometry=Point, coordinates=[longitude,latitude]. Filter on category.\nPointOfInterest: no time axis. Place location; near a point: type=PointOfInterest, georel=near;maxDistance==2000, geometry=Point, coordinates=[longitude,latitude]. Filter on category, name.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "attrs": {
     "items": {
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-.:/#]*$",
      "type": "string"
     },
     "maxItems": 100,
     "minItems": 1,
     "type": "array"
    },
    "coordinates": {
     "maxItems": 1000,
     "type": "array"
    },
    "count": {
     "type": "boolean"
    },
    "cursor": {
     "maxLength": 2048,
     "type": "string"
    },
    "format": {
     "enum": [
      "normalized",
      "concise",
      "keyValues"
     ],
     "type": "string"
    },
    "geometry": {
     "enum": [
      "Point",
      "MultiPoint",
      "LineString",
      "MultiLineString",
      "Polygon",
      "MultiPolygon"
     ],
     "type": "string"
    },
    "geoproperty": {
     "maxLength": 256,
     "pattern": "^[A-Za-z][A-Za-z0-9_\\-.:/#]*$",
     "type": "string"
    },
    "georel": {
     "maxLength": 256,
     "type": "string"
    },
    "id": {
     "items": {
      "maxLength": 512,
      "pattern": "^urn:ngsi-ld:[^\\s]+$",
      "type": "string"
     },
     "maxItems": 100,
     "type": "array"
    },
    "idPattern": {
     "maxLength": 256,
     "type": "string"
    },
    "join": {
     "enum": [
      "flat",
      "inline"
     ],
     "type": "string"
    },
    "joinLevel": {
     "maximum": 3,
     "minimum": 1,
     "type": "integer"
    },
    "lang": {
     "maxLength": 64,
     "type": "string"
    },
    "limit": {
     "maximum": 1000,
     "minimum": 1,
     "type": "integer"
    },
    "local": {
     "type": "boolean"
    },
    "omit": {
     "items": {
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-.:/#]*$",
      "type": "string"
     },
     "maxItems": 100,
     "minItems": 1,
     "type": "array"
    },
    "orderBy": {
     "maxLength": 1024,
     "type": "string"
    },
    "pick": {
     "items": {
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-.:/#]*$",
      "type": "string"
     },
     "maxItems": 100,
     "minItems": 1,
     "type": "array"
    },
    "q": {
     "maxLength": 4096,
     "type": "string"
    },
    "scopeQ": {
     "maxLength": 1024,
     "type": "string"
    },
    "sysAttrs": {
     "type": "boolean"
    },
    "type": {
     "items": {
      "enum": [
       "AdministrativeArea",
       "Bridge",
       "CommitteeSeat",
       "Contract",
       "CouncilMeeting",
       "CouncilVote",
       "CycleRoute",
       "Grant",
       "Invoice",
       "KeyPerformanceIndicator",
       "OfficeHours",
       "Organization",
       "Person",
       "Petition",
       "PointOfInterest",
       "PublicInvestment",
       "PublicOrganization",
       "PublicProcurement",
       "PurchaseOrder",
       "RiverBasin",
       "RoadAccident",
       "RoadStructure",
       "Rule",
       "WaterBodyStatus"
      ],
      "type": "string"
     },
     "maxItems": 50,
     "minItems": 1,
     "type": "array"
    }
   },
   "type": "object"
  },
  "name": "query_entities",
  "title": "Query entities"
 },
