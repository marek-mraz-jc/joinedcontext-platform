/// What the shared host offers a server WASM App beside `wasi:http` (ADR-N-044, AP-144, AP-145).
/// An App never holds a connection string, a password or an object-store key: it asks the host,
/// and the host answers as the App's own database role and under the App's own storage prefix.
/// 0.1.1 adds `identity`, `email` and `ai` (API/06 §5), 0.1.2 adds `blob.presign-put`; neither
/// changes anything before it, so a component built against 0.1.0 or 0.1.1 links unchanged.
package jc:app@0.1.2;

/// The App's own Postgres schema, `app_<id>`, through bound parameters only (AP-144).
interface sql {
    /// One value of a parameter or a column. `json` carries JSON text; `numeric` and `timestamp`
    /// columns come back as `text`.
    variant value {
        null,
        boolean(bool),
        int(s64),
        float(f64),
        text(string),
        bytes(list<u8>),
        json(string),
    }

    /// The rows of a query, column names once and one list of values per row.
    record rows {
        columns: list<string>,
        values: list<list<value>>,
    }

    /// Why a statement did not run. `refused` is the host's or the database's no, with the reason;
    /// the statement's text is never echoed back.
    variant error {
        refused(string),
        invalid(string),
        quota(string),
        timeout,
        unavailable(string),
    }

    /// A statement that reads rows; at most the host's row cap of them come back.
    query: func(statement: string, params: list<value>) -> result<rows, error>;

    /// A statement that writes; the number of rows it changed.
    execute: func(statement: string, params: list<value>) -> result<u64, error>;
}

/// The App's own objects, under its prefix `apps/<shard>/<id>/` (AP-145). Keys are relative to
/// that prefix; one that would leave it is refused.
interface blob {
    variant error {
        refused(string),
        not-found,
        quota(string),
        unavailable(string),
    }

    /// What a presigned URL lets the browser do with one key.
    enum method {
        get,
        put,
    }

    get: func(key: string) -> result<list<u8>, error>;
    put: func(key: string, data: list<u8>, content-type: option<string>) -> result<_, error>;
    /// The keys under `prefix`, relative to the App's own prefix.
    list-keys: func(prefix: string) -> result<list<string>, error>;
    delete: func(key: string) -> result<_, error>;
    /// A URL for one key and one method, valid for at most 300 seconds.
    /// A `put` URL signs no length: upload through `presign-put`, which does.
    presign: func(key: string, method: method, expires-seconds: u32) -> result<string, error>;
    /// A PUT URL for one key whose body is exactly `size` bytes, valid for at most 300 seconds:
    /// the store refuses a body of another length, and the host answers `quota` when the App's
    /// files plus `size` would pass its quota.
    presign-put: func(key: string, size: u64, expires-seconds: u32) -> result<string, error>;
}

/// The person a request comes from, as the Portal verified them for this App (AP-109): an id,
/// a name, an e-mail and the App's roles, never a token.
interface identity {
    record person {
        id: string,
        name: string,
        email: option<string>,
        roles: list<string>,
    }

    /// The request's person; `none` for an anonymous visitor, in a job, and when the Portal
    /// cannot say.
    caller: func() -> option<person>;
}

/// What a platform service answers when it does not (API/06 §3, SDK-43).
interface services {
    /// A service a layer keeps off (`layer`: `organization`, `project` or `app`), or a quota that
    /// is used up (`quota`, and `reset-at` when it frees by itself).
    record refusal {
        service: string,
        layer: option<string>,
        quota: option<string>,
        reset-at: option<string>,
    }

    variant error {
        refused(refusal),
        /// The Portal's other no, with its detail: a message it does not take, a recipient outside
        /// the organization, no model key, no signed-in person.
        rejected(string),
        /// No Portal to ask, or it did not answer.
        unavailable(string),
    }
}

/// A message to people of the organization, by person id or the caller (AP-168); the Portal looks
/// the addresses up, so the App never holds one.
interface email {
    use services.{error};

    variant recipients {
        me,
        people(list<string>),
    }

    record message {
        to: recipients,
        subject: string,
        text: string,
        html: option<string>,
    }

    /// The message's id once the relay took it.
    send: func(message: message) -> result<string, error>;
}

/// A completion from the organization's model, counted against the App's day (AP-169).
interface ai {
    use services.{error};

    enum role {
        system,
        user,
        assistant,
    }

    record message {
        role: role,
        content: string,
    }

    /// `max-tokens` is 1 to 4096, 1024 when absent; `schema` is a JSON Schema as JSON text, and
    /// the answer's `json` is then a value of it.
    record completion {
        messages: list<message>,
        max-tokens: option<u32>,
        schema: option<string>,
    }

    record answer {
        text: string,
        json: option<string>,
        tokens-in: u32,
        tokens-out: u32,
    }

    complete: func(request: completion) -> result<answer, error>;
}

/// What the host links into every App: its storage, its caller and the platform services. The
/// App itself exports `wasi:http/incoming-handler` (AP-143).
world app-host {
    import sql;
    import blob;
    import identity;
    import email;
    import ai;
}
