+//! dev/cg-invariants/fixture.patch: one violation per statement of dev/security.cypher.
+
+/// A token request outside the owners.
+pub async fn cg_fixture_token(url: &str) -> reqwest::Result<reqwest::Response> {
+    cg_fixture_client()
+        .post(url)
+        .form(&[("grant_type", "client_credentials")])
+        .send()
+        .await
+}
+
+/// A client nobody reviewed.
+pub fn cg_fixture_client() -> reqwest::Client {
+    reqwest::Client::new()
+}
+
+/// A child process nobody reviewed.
+pub fn cg_fixture_spawn() -> std::io::Result<std::process::Output> {
+    std::process::Command::new("true").output()
+}
+
+/// SQL text nobody reviewed (sqlx is not a dependency here: the statement greps the wrapper).
+pub fn cg_fixture_sql() -> &'static str {
+    "sqlx::AssertSqlSafe"
+}
+
+/// A file written by a server, its path unchecked.
+pub fn cg_fixture_write(path: &str) -> std::io::Result<()> {
+    std::fs::write(path, b"")
+}
+
+/// A secret out of its wrapper.
+pub fn cg_fixture_secret(secret: &jc_core::Secret) -> String {
+    secret.expose().to_owned()
+}
+
+/// Format code back in the gateway (ADR-N-051).
+pub fn cg_fixture_format() -> zip::write::SimpleFileOptions {
+    zip::write::SimpleFileOptions::default()
+}
